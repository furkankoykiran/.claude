# Personal configuration
config.json
settings.json
settings.json.bak
settings.json.backup.*
# Provider system (local-only; providers/*.json hold auth tokens; .example templates tracked)
providers/*.json
!providers/*.json.example
providers/.active
# NVIDIA gateway config holds the nvapi- key; only its template is tracked
providers/*.yaml
!providers/*.yaml.example

# Installed by RTK — not part of this repo
RTK.md

# Keep example configs (shareable templates)
!config.json.example
!settings.json.example

# Runtime caches
mcp-needs-auth-cache.json
.cache/

# Python cache
__pycache__/
*.pyc
*.pyo

# Temporary/Working directories
cache/
# Exception: the skills-catalog content snapshot IS tracked (immutable, needed
# for offline `catalog:generate`). Only the resolver temp area is ignored.
!catalog/cache/
backups/
debug/
file-history/
ide/
shell-snapshots/
projects/
plugins/

# Memory and state (personal data, but templates are tracked)
memory/*.md
!memory/*.template.md
!memory/README.md
plans/

# History
history.jsonl

# Credentials and sessions (sensitive data)
.credentials.json
sessions/

# Skills: only personal skills are tracked.
# Anything else under skills/ (gstack-installed, third-party plugins, etc.) is ignored.
# When adding a new personal skill, append a `!skills/<name>/` line below.
skills/*
!skills/add-mcp/
!skills/blog-from-chat/
!skills/find-issues/
!skills/find-repos/
!skills/github-comment/
!skills/github-profile-blog/
!skills/humanizer/
!skills/linkedin-post/
!skills/manim-narration/
!skills/pr-followup/
!skills/solve-issue/

# Node.js/Bun (inside gstack)
node_modules/
.bun/

# Catalog resolver working area (temp clones / scratch) — never tracked.
# Note: catalog/cache/ IS tracked (it is the committed immutable content snapshot).
catalog/.tmp/

# Claude Code runtime telemetry (local-only, not catalog work)
telemetry/

# Usage Data
usage-data/

# graphify runtime output (generated per-project on demand, not tracked)
graphify-out/
.graphify/
.graphify_*.json

# Local-only state we never want committed
.last-cleanup
.contextify/

# ---------------------------------------------------------------------------
# Build / test / release transients
# ---------------------------------------------------------------------------
# Release assembly staging (assets are built here under their public names).
/release-staging/
release-assets/

# Coverage and test output
coverage/
.nyc_output/
*.lcov
test-results/

# TypeScript / bundler caches
*.tsbuildinfo
.cache/
dist/
build/

# ---------------------------------------------------------------------------
# Local Claude Code overrides (never committed; the tracked files are the
# shared defaults, these are each machine's private layer)
# ---------------------------------------------------------------------------
CLAUDE.local.md
settings.local.json
.claude.local/

# ---------------------------------------------------------------------------
# Secrets and environment. Committed *.example templates stay tracked.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
!**/*.pub

# ---------------------------------------------------------------------------
# OS and editor state
# ---------------------------------------------------------------------------
.DS_Store
._*
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
.idea/
.vscode/
!.vscode/extensions.json

# ---------------------------------------------------------------------------
# Logs
# ---------------------------------------------------------------------------
*.log
logs/
npm-debug.log*
bun-debug.log*

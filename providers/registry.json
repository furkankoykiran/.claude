{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": 1,
  "runtimes": {
    "claude-code": {
      "name": "Claude Code CLI",
      "pinnedVersion": "2.1.220",
      "upstream": "npm:@anthropic-ai/claude-code"
    },
    "codex": {
      "name": "OpenAI Codex CLI & App Server",
      "pinnedVersion": "2.0.0",
      "upstream": "npm:@openai/codex",
      "protocol": "jsonrpc-2.0"
    },
    "agy": {
      "name": "Antigravity CLI",
      "pinnedVersion": "1.3.3",
      "upstream": "github:google-antigravity/antigravity-cli"
    },
    "litellm": {
      "name": "LiteLLM Proxy (NVIDIA Hosted Gateway)",
      "pinnedVersion": "1.74.1",
      "upstream": "pypi:litellm"
    },
    "bun": {
      "name": "Bun Runtime",
      "pinnedVersion": "1.3.8",
      "upstream": "github:oven-sh/bun"
    },
    "claude-codex-gateway": {
      "name": "Canonical Claude Codex Gateway Submodule",
      "pinnedVersion": "v0.1.3",
      "pinnedSha": "19b64c389fd3ac372b1d54a605c02606430fcd7f",
      "upstream": "github:furkankoykiran/claude-codex-gateway",
      "path": "gateways/claude-codex-gateway"
    },
    "claude-gemini-gateway": {
      "name": "Policy-safe Claude Gemini Gateway Submodule",
      "pinnedVersion": "v0.1.0",
      "pinnedSha": "bd182ebf368b34f1026e449a97cf57a867f9952b",
      "upstream": "github:furkankoykiran/claude-gemini-gateway",
      "path": "gateways/claude-gemini-gateway"
    }
  },
  "providers": [
    {
      "id": "anthropic",
      "name": "Anthropic (official)",
      "aliases": [],
      "authMethod": "official-subscription",
      "transportType": "direct-anthropic",
      "modelDiscovery": false,
      "lifecycle": "none",
      "compatibility": {
        "claudeCode": "supported"
      },
      "requiredRuntime": "none",
      "description": "Official Claude Code service using claude.ai subscription or ANTHROPIC_API_KEY."
    },
    {
      "id": "codex",
      "name": "OpenAI Codex App Server",
      "aliases": ["chatgpt", "chatgpt-entitlement"],
      "authMethod": "delegated-cli",
      "transportType": "local-sidecar",
      "modelDiscovery": true,
      "lifecycle": "session-sidecar",
      "compatibility": {
        "claudeCode": "experimental",
        "nativeCli": "codex",
        "notes": "GPT-6.1 Sol text, Claude-owned Bash/Penpot continuation and fresh next-turn routing are live-proven. Broader MCP/subagent/resume parity remains unproven; see gateway-owned verification."
      },
      "requiredRuntime": "bun, codex, claude-codex-gateway",
      "sidecar": {
        "script": "gateways/claude-codex-gateway/src/index.ts",
        "defaultPort": 4545,
        "healthEndpoint": "/health"
      },
      "description": "Routes Claude Code through local Codex App Server adapter via loopback sidecar."
    },
    {
      "id": "agy",
      "name": "Official Antigravity CLI",
      "aliases": [],
      "authMethod": "delegated-cli",
      "transportType": "local-sidecar",
      "modelDiscovery": true,
      "lifecycle": "session-sidecar",
      "compatibility": {
        "claudeCode": "experimental",
        "nativeCli": "agy",
        "notes": "Official CLI owns authentication. Two sequential Claude text turns and one read-only Claude-owned MCP/result/new-turn path live-proven on the merged gateway. No Gemini API key or broad parity claim."
      },
      "requiredRuntime": "bun, agy, claude-gemini-gateway",
      "sidecar": {
        "script": "gateways/claude-gemini-gateway/src/index.ts",
        "defaultPort": 4141,
        "healthEndpoint": "/health"
      },
      "description": "Claude Code inference through the official local AGY CLI with a mandatory native execution deny guard."
    },
    {
      "id": "gemini",
      "name": "Google Gemini / Vertex AI",
      "aliases": [],
      "authMethod": "vertex-gemini-key",
      "transportType": "local-sidecar",
      "modelDiscovery": true,
      "lifecycle": "session-sidecar",
      "compatibility": {
        "claudeCode": "experimental",
        "notes": "Gemini Developer API or explicit Vertex credentials only. Activation requires a live inference nonce. AGY authentication is separate; no fallback. Live API/Vertex access remains unproven."
      },
      "requiredRuntime": "bun, claude-gemini-gateway",
      "sidecar": {
        "script": "gateways/claude-gemini-gateway/src/index.ts",
        "defaultPort": 4141,
        "healthEndpoint": "/health"
      },
      "description": "Google Developer API / Vertex through the Google gateway; supported credentials required before activation."
    },
    {
      "id": "zai",
      "name": "ZAI GLM-4",
      "aliases": ["glm", "zhipu"],
      "authMethod": "environment",
      "transportType": "direct-anthropic",
      "modelDiscovery": false,
      "lifecycle": "none",
      "compatibility": {
        "claudeCode": "supported"
      },
      "requiredRuntime": "none",
      "description": "Zhipu AI GLM-4 model provider via Anthropic Messages compatibility."
    },
    {
      "id": "deepseek",
      "name": "DeepSeek",
      "aliases": [],
      "authMethod": "environment",
      "transportType": "direct-anthropic",
      "modelDiscovery": false,
      "lifecycle": "none",
      "compatibility": {
        "claudeCode": "supported"
      },
      "requiredRuntime": "none",
      "description": "DeepSeek API provider via Anthropic Messages compatibility."
    },
    {
      "id": "kimi",
      "name": "Moonshot Kimi",
      "aliases": ["moonshot"],
      "authMethod": "environment",
      "transportType": "direct-anthropic",
      "modelDiscovery": false,
      "lifecycle": "none",
      "compatibility": {
        "claudeCode": "supported"
      },
      "requiredRuntime": "none",
      "description": "Moonshot AI Kimi model provider via Anthropic Messages compatibility."
    },
    {
      "id": "minimax",
      "name": "MiniMax",
      "aliases": [],
      "authMethod": "environment",
      "transportType": "direct-anthropic",
      "modelDiscovery": false,
      "lifecycle": "none",
      "compatibility": {
        "claudeCode": "supported"
      },
      "requiredRuntime": "none",
      "description": "MiniMax model provider via Anthropic Messages compatibility."
    },
    {
      "id": "openrouter",
      "name": "OpenRouter",
      "aliases": [],
      "authMethod": "environment",
      "transportType": "direct-anthropic",
      "modelDiscovery": false,
      "lifecycle": "none",
      "compatibility": {
        "claudeCode": "supported"
      },
      "requiredRuntime": "none",
      "description": "OpenRouter multi-model gateway via Anthropic Messages compatibility."
    },
    {
      "id": "nvidia-nim",
      "name": "NVIDIA NIM (self-hosted container)",
      "aliases": ["nim"],
      "authMethod": "environment",
      "transportType": "direct-anthropic",
      "modelDiscovery": false,
      "lifecycle": "none",
      "compatibility": {
        "claudeCode": "supported",
        "notes": "Direct Anthropic Messages connection; no local translating gateway required."
      },
      "requiredRuntime": "none",
      "description": "Self-hosted NVIDIA NIM container serving /v1/messages natively."
    },
    {
      "id": "nvidia",
      "name": "NVIDIA API Catalog (build.nvidia.com)",
      "aliases": ["nvidia-hosted", "build-nvidia"],
      "authMethod": "environment",
      "transportType": "local-sidecar",
      "modelDiscovery": false,
      "lifecycle": "session-sidecar",
      "compatibility": {
        "claudeCode": "experimental"
      },
      "requiredRuntime": "python3 (litellm)",
      "sidecar": {
        "script": "scripts/nim-gateway.sh",
        "defaultPort": 4000,
        "healthEndpoint": "/health/liveliness"
      },
      "description": "Hosted build.nvidia.com catalog translating OpenAI shape to Anthropic Messages via LiteLLM."
    }
  ]
}

{
  "$comment": "OPTIONAL settings only. The safety config — permissions.deny, the update/format/secret-scan hooks, and cleanupPeriodDays — lives in settings.base.json, which `ccs <provider>` merges into settings.json on every switch. Do not copy it here; a second copy only drifts. install.sh seeds settings.json as settings.base.json merged with this file. See docs/configuration.md.",

  "effortLevel": "high",
  "env": {},
  "additionalDirectories": [],

  "statusLine": {
    "type": "command",
    "command": "printf '[%s] %s' \"$(basename \"$PWD\")\" \"$(git branch --show-current 2>/dev/null || echo no-git)\""
  },

  "permissions": {
    "allow": [
      "mcp__github__get_file_contents",
      "mcp__github__get_me",
      "mcp__github__search_repositories",
      "mcp__github__list_commits",
      "mcp__github__list_issues",
      "mcp__github__list_branches",
      "mcp__github__list_pull_requests",
      "mcp__github__search_pull_requests",
      "mcp__github__search_issues",
      "mcp__github__search_code",
      "mcp__github__issue_read",
      "mcp__github__pull_request_read",
      "mcp__github__pull_request_review_write",
      "mcp__context7__resolve-library-id",
      "mcp__context7__query-docs",
      "Read(//root/.claude/**)",
      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:docs.github.com)",
      "WebFetch(domain:modelcontextprotocol.io)",
      "Bash(npm install:*)",
      "Bash(npm info:*)",
      "Bash(npm list:*)",
      "Bash(npx tsc:*)",
      "Bash(uv run:*)",
      "Bash(uv add:*)",
      "Bash(make lint:*)",
      "Bash(make check:*)",
      "Bash(make test:*)",
      "Bash(make format:*)",
      "Bash(git log:*)",
      "Bash(python3 -m json.tool)"
    ]
  }
}

#!/usr/bin/env bash
# cc-provider — switch the Claude Code API provider by COPYING a provider
# file to ~/.claude/settings.json. Copy (not symlink) so it works on every
# platform, including Windows (symlinks need admin/Developer Mode there).
#
#   cc-provider use anthropic -> activate official Anthropic
#   cc-provider zai           -> compatibility shorthand for `use zai`
#   cc-provider list          -> list every available provider
#   cc-provider status        -> print the active provider
#   cc-provider auth zai      -> fill a local provider API key without echoing it
#   cc-provider doctor        -> check the provider setup
#
# The provider set is DATA, not code: whatever `providers/<name>.json.example`
# templates exist are the valid names, so adding a provider means dropping in a
# template — no edits here, in install.sh, or in install.ps1.
#
# Provider files (providers/<name>.json) are local and gitignored (auth
# tokens live here). Templates (providers/<name>.json.example) are committed
# with a <ZAI_TOKEN>-style placeholder. providers/.active records the choice.
#
# settings.json is GENERATED by merging, lowest precedence first:
#   the existing settings.json (carried over) <- settings.base.json <- the
#   provider file. Edit the provider file for credentials and models, or
#   settings.base.json for repo-owned safety config, then re-run
#   `ccs <provider>` — do not edit settings.json directly.
# Claude Code reads env at startup, so restart it after switching.
set -euo pipefail

CLAUDE_DIR="${CLAUDE_DIR:-$HOME/.claude}"
PDIR="$CLAUDE_DIR/providers"
SETTINGS="$CLAUDE_DIR/settings.json"
BASE_SETTINGS="$CLAUDE_DIR/settings.base.json"
CODEX_GATEWAY_PID="$CLAUDE_DIR/state/codex-gateway.pid"
CODEX_GATEWAY_LOG="$CLAUDE_DIR/state/codex-gateway.log"
CODEX_ACCOUNT_CACHE="$CLAUDE_DIR/state/codex-account-cache.json"
CODEX_CONFIG="${CODEX_CONFIG:-$HOME/.codex/config.toml}"
PLACEHOLDER_RE='<[A-Z_]+>'

# Keys the ACTIVE PROVIDER owns outright. Each is taken from the provider file
# and removed when that file does not set it, so stale routing credentials cannot
# outlive a switch. UX policy such as effortLevel and enabledPlugins is carried
# over from the user's settings instead of being reset by provider templates.
PROVIDER_KEYS='["env","model","apiKeyHelper","modelDiscoveryEnabled","modelPrefer1mContext","inferenceModels","inferenceModelPricingEnabled","inferenceModelPricing","inferenceModelPricingMultiplier","modelPicker"]'

die() { printf 'cc-provider: %s\n' "$*" >&2; exit 1; }

need_provider_arg() {
  local cmd="$1" p="${2:-}"
  [ -n "$p" ] || die "$cmd requires a provider name"
  [ "${3:-}" = "" ] || die "$cmd accepts exactly one provider name"
}

is_codex_entitlement() {
  case "$1" in
    codex|chatgpt|chatgpt-entitlement) return 0 ;;
    *) return 1 ;;
  esac
}

delegate_codex() {
  local action="$1"
  command -v codex >/dev/null 2>&1 \
    || die "codex CLI is not installed; install/sign in with official Codex tooling first"
  case "$action" in
    login|status|logout) codex "$action" ;;
    *) die "unsupported Codex action: $action" ;;
  esac
}

redact_secret() {
  local v="$1" n suffix
  [ -n "$v" ] || { printf 'empty'; return; }
  n=${#v}
  if [ "$n" -le 4 ]; then
    printf 'configured (****)'
  else
    suffix=${v: -4}
    printf 'configured (****%s)' "$suffix"
  fi
}

sanitize_codex_display() {
  # Strip terminal escape sequences and the common leftover SGR suffix shape
  # that appears when an upstream model label has already lost its ESC byte.
  printf '%s' "$1" | sed -E $'s/\x1B\\[[0-9;?]*[ -/]*[@-~]//g; s/\\[[0-9;]*m//g; s/[[:cntrl:]]//g'
}

codex_gateway_port() {
  if [ -f "$PDIR/codex.json" ] && command -v jq >/dev/null 2>&1; then
    jq -r '.env.CODEX_GATEWAY_PORT // "4545"' "$PDIR/codex.json" 2>/dev/null || printf '4545'
  else
    printf '4545'
  fi
}

codex_gateway_running() {
  [ -f "$CODEX_GATEWAY_PID" ] || return 1
  local pid
  pid=$(cat "$CODEX_GATEWAY_PID" 2>/dev/null || true)
  [ -n "$pid" ] || return 1
  kill -0 "$pid" 2>/dev/null
}

codex_gateway_health_running() {
  command -v curl >/dev/null 2>&1 || return 1
  curl -fsS --max-time 1 "http://127.0.0.1:$(codex_gateway_port)/health" >/dev/null 2>&1
}

codex_gateway_port_listening() {
  local port
  port=$(codex_gateway_port)
  [ -n "$port" ] || return 1
  (exec 3<>"/dev/tcp/127.0.0.1/$port") >/dev/null 2>&1
}

codex_gateway_available() {
  codex_gateway_running || codex_gateway_health_running
}

scrub_codex_bridge_mcp_config() {
  # In ccs codex bridge mode, Claude Code owns Claude-side MCP tools. Older
  # toolkit builds also registered github/context7 inside native Codex with a
  # now-deleted HTTP headers helper, which makes Codex app-server stall before
  # the first useful response. Remove only those toolkit bridge duplicates and
  # preserve any user-owned Codex MCP entries.
  [ -f "$CODEX_CONFIG" ] || return 0
  command -v awk >/dev/null 2>&1 || return 0

  local tmp backup removed
  tmp="$(mktemp "${TMPDIR:-/tmp}/codex-config.XXXXXX")" || return 0
  removed="$({
    awk -v helper="codex-mcp-headers-helper.js" '
      function is_header(line) { return line ~ /^\[mcp_servers\."[^"]+"\]/ }
      function is_bridge_name(header) {
        return header == "[mcp_servers.\"github\"]" || header == "[mcp_servers.\"context7\"]"
      }
      function flush(    block_text) {
        if (!in_block) return
        block_text = block
        if (is_bridge_name(block_header) && index(block_text, helper) > 0) {
          removed = 1
        } else {
          printf "%s", block
        }
        in_block = 0
        block = ""
        block_header = ""
      }
      is_header($0) {
        flush()
        in_block = 1
        block_header = $0
        block = $0 ORS
        next
      }
      /^\[/ {
        flush()
        print
        next
      }
      in_block {
        block = block $0 ORS
        next
      }
      { print }
      END {
        flush()
        if (removed) print "removed" > "/dev/stderr"
      }
    ' "$CODEX_CONFIG" > "$tmp"
  } 2>&1)"
  if printf "%s\n" "$removed" | grep -qxF removed; then
    backup="$CODEX_CONFIG.bak.$(date -u +%Y%m%d-%H%M%S)"
    cp "$CODEX_CONFIG" "$backup" 2>/dev/null || true
    chmod --reference="$CODEX_CONFIG" "$tmp" 2>/dev/null || chmod 600 "$tmp"
    mv -f "$tmp" "$CODEX_CONFIG"
    printf "Removed duplicate Claude-owned Codex MCP registrations from %s (backup: %s).\n" "$CODEX_CONFIG" "$backup"
  else
    rm -f "$tmp"
  fi
}

start_codex_gateway() {
  is_provider codex || die "codex provider template is missing"
  ensure_provider_file codex
  command -v bun >/dev/null 2>&1 || die "bun is required to run the Codex gateway"
  command -v codex >/dev/null 2>&1 || die "codex CLI is required; install it and run: ccs login codex"
  mkdir -p "$(dirname "$CODEX_GATEWAY_PID")"
  scrub_codex_bridge_mcp_config
  if codex_gateway_running; then
    printf 'Codex gateway already running (pid %s, port %s).\n' "$(cat "$CODEX_GATEWAY_PID")" "$(codex_gateway_port)"
    return 0
  fi
  if codex_gateway_health_running; then
    printf 'Codex gateway already running (health, port %s).\n' "$(codex_gateway_port)"
    return 0
  fi
  local port model effort
  port=$(codex_gateway_port)
  if codex_gateway_port_listening; then
    die "Codex gateway port $port is occupied but /health is not reachable; stop the other listener or choose another CODEX_GATEWAY_PORT"
  fi
  model=$(sanitize_codex_display "$(jq -r '.env.CODEX_GATEWAY_MODEL // empty' "$PDIR/codex.json")")
  effort=$(jq -r '.env.CODEX_GATEWAY_REASONING_EFFORT // empty' "$PDIR/codex.json")
  if command -v setsid >/dev/null 2>&1; then
    nohup setsid env CODEX_GATEWAY_PORT="$port" CODEX_GATEWAY_MODEL="$model" CODEX_GATEWAY_REASONING_EFFORT="$effort" \
      bun run "$CLAUDE_DIR/scripts/codex-anthropic-gateway.ts" serve >"$CODEX_GATEWAY_LOG" 2>&1 &
  else
    CODEX_GATEWAY_PORT="$port" CODEX_GATEWAY_MODEL="$model" CODEX_GATEWAY_REASONING_EFFORT="$effort" \
      nohup bun run "$CLAUDE_DIR/scripts/codex-anthropic-gateway.ts" serve >"$CODEX_GATEWAY_LOG" 2>&1 &
  fi
  printf '%s\n' "$!" > "$CODEX_GATEWAY_PID"
  sleep 1
  if codex_gateway_running; then
    printf 'Codex gateway started (pid %s, port %s, model %s, effort %s).\n' "$(cat "$CODEX_GATEWAY_PID")" "$port" "${model:-unset}" "${effort:-default}"
  else
    rm -f "$CODEX_GATEWAY_PID"
    die "Codex gateway failed to start; see $CODEX_GATEWAY_LOG"
  fi
}

stop_codex_gateway() {
  if ! codex_gateway_running; then
    rm -f "$CODEX_GATEWAY_PID"
    printf 'Codex gateway is not running.\n'
    return 0
  fi
  local pid
  pid=$(cat "$CODEX_GATEWAY_PID")
  kill "$pid" 2>/dev/null || true
  rm -f "$CODEX_GATEWAY_PID"
  printf 'Codex gateway stopped (pid %s).\n' "$pid"
}

status_codex_gateway() {
  if codex_gateway_running; then
    printf 'Codex gateway: running (pid %s, port %s)\n' "$(cat "$CODEX_GATEWAY_PID")" "$(codex_gateway_port)"
  elif codex_gateway_health_running; then
    printf 'Codex gateway: running (health, port %s)\n' "$(codex_gateway_port)"
  elif codex_gateway_port_listening; then
    printf 'Codex gateway: blocked (port %s occupied; /health unavailable)\n' "$(codex_gateway_port)"
  else
    printf 'Codex gateway: stopped\n'
  fi
  if [ -f "$PDIR/codex.json" ] && command -v jq >/dev/null 2>&1; then
    printf 'Codex model: %s\n' "$(sanitize_codex_display "$(jq -r '.env.CODEX_GATEWAY_MODEL // "unset"' "$PDIR/codex.json")")"
    printf 'Codex reasoning effort: %s\n' "$(jq -r '.env.CODEX_GATEWAY_REASONING_EFFORT // "default"' "$PDIR/codex.json")"
  fi
}

codex_models_json() {
  is_provider codex || die "codex provider template is missing"
  command -v curl >/dev/null 2>&1 || die "curl is required to query the Codex model catalog"
  if ! codex_gateway_available; then
    start_codex_gateway >/dev/null
  fi
  local url
  url="http://127.0.0.1:$(codex_gateway_port)/v1/models"
  curl -fsS "$url" || die "failed to query Codex model catalog at $url"
}

codex_gateway_json() {
  local path="$1" cache_key="${2:-}" cache_ttl="${3:-0}" url now cache_age
  is_provider codex || die "codex provider template is missing"
  command -v curl >/dev/null 2>&1 || die "curl is required to query Codex account data"
  if ! codex_gateway_available; then
    start_codex_gateway >/dev/null
  fi
  mkdir -p "$(dirname "$CODEX_ACCOUNT_CACHE")"
  now=$(date +%s)
  if [ -n "$cache_key" ] && [ -f "$CODEX_ACCOUNT_CACHE" ] && command -v jq >/dev/null 2>&1; then
    cache_age=$(jq -r --arg key "$cache_key" --argjson now "$now" --argjson ttl "$cache_ttl" '
      if (.[$key].ts? // 0) > 0 and (($now - .[$key].ts) < $ttl) then "fresh" else "stale" end
    ' "$CODEX_ACCOUNT_CACHE" 2>/dev/null || printf 'stale')
    if [ "$cache_age" = "fresh" ]; then
      jq -c --arg key "$cache_key" '.[$key].data' "$CODEX_ACCOUNT_CACHE"
      return
    fi
  fi
  url="http://127.0.0.1:$(codex_gateway_port)$path"
  local json
  json=$(curl -fsS "$url") || die "failed to query Codex account data at $url"
  if [ -n "$cache_key" ] && command -v jq >/dev/null 2>&1; then
    local tmp
    [ -f "$CODEX_ACCOUNT_CACHE" ] || printf '{}\n' > "$CODEX_ACCOUNT_CACHE"
    tmp="$(mktemp "$CLAUDE_DIR/state/.codex-account-cache.XXXXXX")"
    jq -n --arg key "$cache_key" --argjson now "$now" --argjson data "$json" --slurpfile old "$CODEX_ACCOUNT_CACHE" '
      (($old[0] // {}) | if type == "object" then . else {} end)
      | .[$key] = {ts: $now, data: $data}
    ' > "$tmp" 2>/dev/null && mv -f "$tmp" "$CODEX_ACCOUNT_CACHE" || rm -f "$tmp"
  fi
  printf '%s\n' "$json"
}

redact_email_for_display() {
  awk -F@ '{
    if (NF != 2 || $1 == "" || $2 == "") { print "redacted"; next }
    prefix=substr($1,1,2)
    print prefix "***@" $2
  }'
}

format_epoch_utc() {
  local epoch="$1"
  case "$epoch" in ''|null|*[!0-9]*) printf 'unavailable'; return ;; esac
  date -u -d "@$epoch" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null \
    || date -u -r "$epoch" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null \
    || printf '%s' "$epoch"
}

format_time_until() {
  local epoch="$1" now delta days hours mins
  case "$epoch" in ''|null|*[!0-9]*) printf 'unavailable'; return ;; esac
  now=$(date +%s)
  delta=$((epoch - now))
  if [ "$delta" -le 0 ]; then
    printf 'elapsed'
    return
  fi
  days=$((delta / 86400))
  hours=$(((delta % 86400) / 3600))
  mins=$(((delta % 3600) / 60))
  if [ "$days" -gt 0 ]; then
    printf '%sd %sh %sm' "$days" "$hours" "$mins"
  elif [ "$hours" -gt 0 ]; then
    printf '%sh %sm' "$hours" "$mins"
  else
    printf '%sm' "$mins"
  fi
}

codex_account_json() {
  codex_gateway_json "/codex/account" account 30
}

codex_rate_limits_json() {
  codex_gateway_json "/codex/rate-limits" rateLimits 30
}

codex_usage_json() {
  codex_gateway_json "/codex/usage" usage 30
}

print_codex_account() {
  command -v jq >/dev/null 2>&1 || die "jq is required to format Codex account data"
  local account_json model effort
  account_json=$(codex_account_json) || { printf 'Codex account: unavailable\nUsage unavailable - open ChatGPT Settings -> Usage.\n'; return 0; }
  model="unset"
  effort="default"
  if [ -f "$PDIR/codex.json" ]; then
    model=$(sanitize_codex_display "$(jq -r '.env.CODEX_GATEWAY_MODEL // .model // "unset"' "$PDIR/codex.json" 2>/dev/null || printf 'unset')")
    effort=$(jq -r '.env.CODEX_GATEWAY_REASONING_EFFORT // "default"' "$PDIR/codex.json" 2>/dev/null || printf 'default')
  fi
  printf 'Codex account\n'
  printf '  Status: %s\n' "$(printf '%s\n' "$account_json" | jq -r 'if .account == null then "signed out or unavailable" else "signed in" end')"
  printf '  Auth mode: %s\n' "$(printf '%s\n' "$account_json" | jq -r '.account.type // (if .requiresOpenaiAuth then "openai auth required" else "unknown" end)')"
  printf '  Account: %s\n' "$(printf '%s\n' "$account_json" | jq -r '.account.email // empty' | redact_email_for_display)"
  printf '  Plan: %s\n' "$(printf '%s\n' "$account_json" | jq -r '.account.planType // "unavailable"')"
  printf '  Model: %s\n' "$model"
  printf '  Effort: %s\n' "$effort"
  printf '  Last refresh: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
}

print_codex_usage() {
  command -v jq >/dev/null 2>&1 || die "jq is required to format Codex usage data"
  local limits_json usage_json
  limits_json=$(codex_rate_limits_json) || {
    printf 'Usage unavailable - open ChatGPT Settings -> Usage.\n'
    return 0
  }
  usage_json=$(codex_usage_json 2>/dev/null || printf '{}')
  printf 'Codex usage\n'
  printf '  Ordinary usage: %s\n' "$(printf '%s\n' "$limits_json" | jq -r 'if .ordinaryUsageAllowed == true then "allowed" elif .ordinaryUsageAllowed == false then "exhausted" else "unavailable" end')"
  while IFS="$(printf '\t')" read -r kind limit_id window_name used_percent resets_at window_mins; do
    case "$kind" in
      limit)
        printf '  Limit: %s\n' "$limit_id"
        ;;
      window)
        printf '  %s: used %s%%' "$window_name" "$used_percent"
        if [ "$resets_at" != "null" ]; then
          printf ' | resets %s (%s)' "$(format_epoch_utc "$resets_at")" "$(format_time_until "$resets_at")"
        fi
        if [ "$window_mins" != "null" ]; then
          printf ' | windowMins %s' "$window_mins"
        fi
        printf '\n'
        ;;
    esac
  done <<EOF_USAGE_WINDOWS
$(printf '%s\n' "$limits_json" | jq -r '
    (.rateLimitsByLimitId // {"default": .rateLimits}) as $limits
    | $limits
    | to_entries[]
    | . as $entry
    | (["limit", $entry.key, "", "", "", ""] | @tsv),
      (if $entry.value.primary == null then empty else ["window", $entry.key, "primary", ($entry.value.primary.usedPercent // "unavailable"), ($entry.value.primary.resetsAt // "null"), ($entry.value.primary.windowDurationMins // "null")] | @tsv end),
      (if $entry.value.secondary == null then empty else ["window", $entry.key, "secondary", ($entry.value.secondary.usedPercent // "unavailable"), ($entry.value.secondary.resetsAt // "null"), ($entry.value.secondary.windowDurationMins // "null")] | @tsv end)
  ')
EOF_USAGE_WINDOWS
  printf '  Reset credits: %s\n' "$(printf '%s\n' "$limits_json" | jq -r '.rateLimitResetCredits.availableCount // "unavailable"')"
  printf '  Token usage summary: %s\n' "$(printf '%s\n' "$usage_json" | jq -r 'if .summary then (.summary | to_entries | map("\(.key)=\(.value // "null")") | join(", ")) else "unavailable" end')"
  printf '  Last refresh: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  printf '  Official details: ChatGPT Settings -> Usage\n'
}

refresh_codex_model_discovery() {
  ensure_provider_file codex
  command -v jq >/dev/null 2>&1 || return 0
  local json tmp selected
  json=$(codex_models_json) || return 0
  selected=$(jq -r '.env.CODEX_GATEWAY_MODEL // "gpt-5.5"' "$PDIR/codex.json")
  tmp="$(mktemp "$PDIR/.codex.json.XXXXXX")"
  jq --argjson catalog "$json" --arg selected "$selected" '
    def catalog_models:
      ($catalog.data // []) | map(select((.id // "") != ""));
    def known_models:
      catalog_models
      | map(
          {
            name: .id,
            labelOverride: (.display_name // .id)
          }
          + (if .id == $selected or (.metadata.is_default == true) then {anthropicFamilyTier: "sonnet"} else {} end)
          + (if .id == $selected then {isFamilyDefault: true} else {} end)
        );
    def picker_models:
      catalog_models
      | map({
          model: .id,
          label: (.display_name // .id),
          description: (.metadata.description // .description // "Codex model"),
          behavesAs: "claude-sonnet-4-5"
        });
    .modelDiscoveryEnabled = true
    | .inferenceModelPricingEnabled = false
    | .model = $selected
    | .env.ANTHROPIC_DEFAULT_HAIKU_MODEL = $selected
    | .env.ANTHROPIC_DEFAULT_SONNET_MODEL = $selected
    | .env.ANTHROPIC_DEFAULT_OPUS_MODEL = $selected
    | .env.CLAUDE_CODE_SUBAGENT_MODEL = $selected
    | .inferenceModels = known_models
    | .modelPicker = {options: picker_models}
  ' "$PDIR/codex.json" > "$tmp" || { rm -f "$tmp"; return 0; }
  chmod 600 "$tmp"
  mv -f "$tmp" "$PDIR/codex.json"
}

codex_picker_status() {
  command -v jq >/dev/null 2>&1 || return 0
  local provider_count settings_count pricing selected
  if [ -f "$PDIR/codex.json" ]; then
    provider_count=$(jq -r '(.modelPicker.options // []) | length' "$PDIR/codex.json" 2>/dev/null || printf '0')
    selected=$(sanitize_codex_display "$(jq -r '.env.CODEX_GATEWAY_MODEL // .model // "unset"' "$PDIR/codex.json" 2>/dev/null || printf 'unset')")
    printf 'Codex picker catalog: %s model(s) cached in providers/codex.json\n' "$provider_count"
    printf 'Codex selected model: %s\n' "$selected"
  fi
  if [ -f "$SETTINGS" ]; then
    settings_count=$(jq -r '(.modelPicker.options // []) | length' "$SETTINGS" 2>/dev/null || printf '0')
    pricing=$(jq -r '.inferenceModelPricingEnabled // false' "$SETTINGS" 2>/dev/null || printf 'false')
    printf 'Claude /model Codex rows: %s cached in settings.json\n' "$settings_count"
    printf 'Codex pricing estimate: %s\n' "$pricing"
  fi
  printf 'Codex gateway discovery: Claude Code keeps only raw /v1/models ids containing claude or anthropic; Codex ids use generated modelPicker rows.\n'
}

list_codex_models() {
  local json
  json=$(codex_models_json)
  if command -v jq >/dev/null 2>&1; then
    printf '%s\n' "$json" | jq -r '
      if .data then
        .data[]
        | [.id, (.display_name // .id), (.metadata.default_reasoning_effort // ""), ((.metadata.supported_reasoning_efforts // []) | map(.reasoningEffort // .) | join(",")), (if .metadata.is_default then "default" else "" end)]
        | @tsv
      else
        error(.error.message // "invalid Codex model catalog response")
      end
    ' | awk 'BEGIN { printf "%-22s %-22s %-8s %-28s %s\n", "id", "display", "default", "efforts", "notes" } { printf "%-22s %-22s %-8s %-28s %s\n", $1, $2, $3, $4, $5 }'
  else
    printf '%s\n' "$json"
  fi
}

set_codex_model() {
  local model="${1:-}" effort="${2:-medium}" tmp
  model=$(sanitize_codex_display "$model")
  [ -n "$model" ] || die "codex-model requires a Codex model id (example: ccs codex-model gpt-5.5 medium)"
  case "$effort" in low|medium|high|xhigh|none) ;; *) die "reasoning effort must be one of: none, low, medium, high, xhigh" ;; esac
  ensure_provider_file codex
  command -v jq >/dev/null 2>&1 || die "jq is required to update providers/codex.json"
  tmp="$(mktemp "$PDIR/.codex.json.XXXXXX")"
  jq --arg model "$model" --arg effort "$effort" '
    .model = $model
    | .modelDiscoveryEnabled = true
    | .inferenceModelPricingEnabled = false
    | .env.ANTHROPIC_DEFAULT_HAIKU_MODEL = $model
    | .env.ANTHROPIC_DEFAULT_SONNET_MODEL = $model
    | .env.ANTHROPIC_DEFAULT_OPUS_MODEL = $model
    | .env.CLAUDE_CODE_SUBAGENT_MODEL = $model
    | .env.CODEX_GATEWAY_MODEL = $model
    | .env.CODEX_GATEWAY_REASONING_EFFORT = $effort
  ' "$PDIR/codex.json" > "$tmp"
  chmod 600 "$tmp"
  mv -f "$tmp" "$PDIR/codex.json"
  printf 'Codex model set to %s (reasoning effort %s).\n' "$model" "$effort"
  if [ -f "$PDIR/.active" ] && [ "$(cat "$PDIR/.active")" = "codex" ]; then
    stop_codex_gateway >/dev/null 2>&1 || true
    activate codex
  fi
}


# Provider names, one per line: every .json.example template, plus any local
# .json a user added by hand. Sorted and de-duplicated.
list_providers() {
  local f name
  {
    for f in "$PDIR"/*.json.example; do
      [ -e "$f" ] || continue
      name=${f##*/}; printf '%s\n' "${name%.json.example}"
    done
    for f in "$PDIR"/*.json; do
      [ -e "$f" ] || continue
      name=${f##*/}; printf '%s\n' "${name%.json}"
    done
  } | sort -u
}

is_provider() {
  list_providers | grep -qxF "$1"
}

ensure_provider_file() {
  local p="$1"
  if [ ! -f "$PDIR/$p.json" ]; then
    if [ -f "$PDIR/$p.json.example" ]; then
      cp "$PDIR/$p.json.example" "$PDIR/$p.json"
      chmod 600 "$PDIR/$p.json"
      printf 'Created providers/%s.json from template.\n' "$p" >&2
    else
      die "no providers/$p.json or $p.json.example to seed from"
    fi
  fi
  if grep -qE "$PLACEHOLDER_RE" "$PDIR/$p.json" 2>/dev/null; then
    printf 'WARNING: providers/%s.json still has placeholder values (<...>).\n' "$p" >&2
    printf 'Edit it and fill your real token before relying on this provider.\n' >&2
  fi
}


credential_key() {
  local p="$1" f
  f="$PDIR/$p.json"
  [ -f "$f" ] || return 1
  jq -r '
    (.env // {}) as $env
    | (["ANTHROPIC_AUTH_TOKEN","ANTHROPIC_API_KEY"]
       | map(. as $k | select($env | has($k)) | {key: $k, value: (($env[$k] // "") | tostring)})) as $keys
    | (($keys | map(select(.value | test("^<[^>]+>$"))) | .[0].key)
       // ($keys | map(select(.value == "")) | .[0].key)
       // ($keys | .[0].key)
       // empty)
  ' "$f"
}

credential_value() {
  local p="$1" key="$2"
  [ -n "$key" ] || return 1
  jq -r --arg key "$key" '(.env[$key] // "") | tostring' "$PDIR/$p.json"
}

provider_auth_status() {
  local p="$1" f key value
  f="$PDIR/$p.json"
  if is_codex_entitlement "$p"; then
    printf 'Auth mode: ChatGPT entitlement via official codex login/status/logout (no API key is copied).\n'
    return 0
  fi
  [ -f "$f" ] || { printf 'Auth mode: not configured (no providers/%s.json yet).\n' "$p"; return 0; }
  key=$(credential_key "$p" || true)
  if [ -z "$key" ]; then
    if jq -e '.env.ANTHROPIC_BASE_URL? | test("127.0.0.1|localhost|0.0.0.0")' "$f" >/dev/null 2>&1; then
      printf 'Auth mode: local/gateway provider (no API key stored in providers/%s.json).\n' "$p"
    else
      printf 'Auth mode: no API key field in providers/%s.json.\n' "$p"
    fi
    return 0
  fi
  value=$(credential_value "$p" "$key")
  case "$value" in
    ''|\<*) printf 'Auth mode: API key required in %s (not configured).\n' "$key" ;;
    *) printf 'Auth mode: API key in %s is %s.\n' "$key" "$(redact_secret "$value")" ;;
  esac
}

prompt_secret() {
  local prompt="$1" secret
  if [ -n "${CC_PROVIDER_API_KEY:-}" ]; then
    printf '%s' "$CC_PROVIDER_API_KEY"
    return 0
  fi
  if [ ! -t 0 ]; then
    die "no API key provided on stdin; run interactively or set CC_PROVIDER_API_KEY for tests"
  fi
  printf '%s' "$prompt" >&2
  if read -r -s secret; then
    printf '\n' >&2
    printf '%s' "$secret"
  else
    printf '\n' >&2
    return 1
  fi
}

write_api_key() {
  local p="$1" key secret tmp
  if is_codex_entitlement "$p"; then
    die "$p uses ChatGPT entitlement. Use: ccs login $p (delegates to codex login), not an API key."
  fi
  is_provider "$p" || die "unknown provider: $p"
  ensure_provider_file "$p"
  command -v jq >/dev/null 2>&1 || die "jq is required to update providers/$p.json"
  key=$(credential_key "$p" || true)
  [ -n "$key" ] || die "providers/$p.json has no ANTHROPIC_AUTH_TOKEN or ANTHROPIC_API_KEY field to fill"
  secret=$(prompt_secret "Enter API key for $p ($key): ")
  [ -n "$secret" ] || die "empty API key; providers/$p.json was not changed"
  tmp="$(mktemp "$PDIR/.$p.json.XXXXXX")"
  jq --arg key "$key" --arg secret "$secret" '.env[$key] = $secret' "$PDIR/$p.json" > "$tmp"
  chmod 600 "$tmp"
  mv -f "$tmp" "$PDIR/$p.json"
  printf 'Updated providers/%s.json (%s: %s).\n' "$p" "$key" "$(redact_secret "$secret")"
  if [ -f "$PDIR/.active" ] && [ "$(cat "$PDIR/.active")" = "$p" ]; then
    activate "$p"
  else
    printf 'Run %s to activate it.\n' "ccs use $p"
  fi
}

logout_provider() {
  local p="$1" f key tmp
  f="$PDIR/$p.json"
  if is_codex_entitlement "$p"; then
    delegate_codex logout
    return
  fi
  is_provider "$p" || die "unknown provider: $p"
  [ -f "$f" ] || { printf 'Provider %s has no local file to clear.\n' "$p"; return 0; }
  key=$(credential_key "$p" || true)
  [ -n "$key" ] || { printf 'Provider %s has no API key field to clear.\n' "$p"; return 0; }
  tmp="$(mktemp "$PDIR/.$p.json.XXXXXX")"
  jq --arg key "$key" '.env[$key] = ""' "$f" > "$tmp"
  chmod 600 "$tmp"
  mv -f "$tmp" "$f"
  printf 'Cleared API key in providers/%s.json (%s).\n' "$p" "$key"
  if [ -f "$PDIR/.active" ] && [ "$(cat "$PDIR/.active")" = "$p" ]; then
    activate "$p"
  fi
}

# Providers that point at a loopback base URL (the NVIDIA gateway, a self-hosted
# NIM container, a local Ollama) are dead until that listener is up, and the
# symptom in Claude Code is an opaque connection error. Warn at switch time
# instead. Best-effort: a parse miss just skips the check.
warn_if_local_endpoint_down() {
  local p="$1" url host port
  url=$(sed -n 's/.*"ANTHROPIC_BASE_URL"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
        "$PDIR/$p.json" 2>/dev/null | head -1)
  case "$url" in
    *//127.0.0.1:*|*//localhost:*|*//0.0.0.0:*) ;;
    *) return 0 ;;
  esac
  host=${url#*//}; port=${host##*:}; host=${host%%:*}
  port=${port%%/*}
  case "$port" in ''|*[!0-9]*) return 0 ;; esac
  if ! (exec 3<>"/dev/tcp/$host/$port") 2>/dev/null; then
    printf 'WARNING: nothing is listening on %s:%s, which providers/%s.json points at.\n' \
      "$host" "$port" "$p" >&2
    if [ "$p" = "nvidia" ]; then
      printf 'Start the gateway first: %s/scripts/nim-gateway.sh start\n' "$CLAUDE_DIR" >&2
    elif [ "$p" = "codex" ]; then
      printf 'Start the experimental gateway first: bun run %s/scripts/codex-anthropic-gateway.ts\n' "$CLAUDE_DIR" >&2
    fi
  fi
}

# settings.json used to be a straight `cp` of the provider file. That silently
# deleted every repo-owned safety control the moment anyone switched provider:
# the 12 docker-volume deny rules and all three safety hooks shipped by this
# repo were absent from every provider template, so the guard was present in
# git, passed review, and did nothing on any machine that had ever run `ccs`.
#
# The switch is now a merge of three layers, lowest precedence first:
#
#   1. the existing settings.json  — carried over, minus PROVIDER_KEYS
#   2. settings.base.json          — repo-owned safety config, always applied
#   3. providers/<name>.json       — the provider's own keys, applied last
#
# permissions.deny and hooks are UNIONED across all three rather than replaced,
# because a deny rule that a later layer happens not to mention must not be
# dropped. Everything else is last-writer-wins.
merge_settings() {
  local provider_file="$1" out="$2" base='{}' current='{}'
  [ -f "$BASE_SETTINGS" ] && base="$(cat "$BASE_SETTINGS")"
  [ -f "$SETTINGS" ] && current="$(cat "$SETTINGS")"

  jq -n \
    --argjson provider_keys "$PROVIDER_KEYS" \
    --slurpfile base_arr <(printf '%s' "$base") \
    --slurpfile cur_arr <(printf '%s' "$current") \
    --slurpfile prov_arr "$provider_file" '
    def dedupe: reduce .[] as $x ([]; if any(.[]; . == $x) then . else . + [$x] end);

    # Identity of a hook handler. Keyed on the whole descriptor minus its
    # tunables when it has a command, so the same command declared twice is one
    # handler, and a LATER layer wins for it (a changed timeout, say).
    # Handlers with no `command` at all — prompt-type hooks, for instance —
    # cannot share that key or they would all collide on the empty string and
    # only the first would survive, so they are identified by their full value.
    def hook_key($m; $h):
      if ($h | type) == "object" and ($h.command? // null) != null
      then [$m, ($h.type // "command"), $h.command]
      else [$m, ($h | tojson)]
      end;

    # Union hook handlers across layers, keeping first-seen order but letting a
    # later layer replace the descriptor at the same identity. Regrouping by
    # first-seen matcher keeps one group per matcher rather than accumulating a
    # new group on every switch.
    def merge_hooks($layers):
      reduce ($layers[] | (.hooks // {}) | to_entries[]) as $e ({};
        .[$e.key] = ((.[$e.key] // []) + $e.value))
      | with_entries(.value |= (
          [ .[] as $g | ($g.hooks // [])[] | {m: ($g.matcher // ""), h: ., k: hook_key(($g.matcher // ""); .)} ]
          | reduce .[] as $p ([];
              (map(.k) | index([$p.k])) as $i
              | if $i == null then . + [$p] else (.[$i] = $p) end)
          | reduce .[] as $p ([];
              (map(.m) | index($p.m)) as $i
              | if $i == null then . + [{m: $p.m, hooks: [$p.h]}]
                else .[$i].hooks += [$p.h] end)
          | map(if .m == "" then {hooks} else {matcher: .m, hooks} end)
        ));

    ($base_arr[0] // {}) as $base
    | ($cur_arr[0] // {}) as $cur
    | (($prov_arr[0] // {}) | del(.enabledPlugins, .effortLevel)) as $prov
    # Strip the provider-owned keys from the carried-over layer first, so an
    # absent key in the new provider file deletes rather than inherits.
    | ($cur | delpaths($provider_keys | map([.]))) as $carry
    | ($carry * $base * $prov)
    | del(._comment)
    | .permissions = (
        ((($carry.permissions // {}) * ($base.permissions // {}) * ($prov.permissions // {})))
        | .deny = ((($base.permissions.deny // []) + ($prov.permissions.deny // [])
                    + ($carry.permissions.deny // [])) | dedupe)
        | .allow = ((($base.permissions.allow // []) + ($prov.permissions.allow // [])
                     + ($carry.permissions.allow // [])) | dedupe)
        | if (.allow | length) == 0 then del(.allow) else . end
      )
    | .hooks = merge_hooks([$carry, $base, $prov])
    # Provider-owned keys, settled in one pass. Present in the provider file ->
    # assigned STRAIGHT from it, because `*` merges objects recursively and
    # would otherwise leave a lower layer env.ANTHROPIC_BASE_URL sitting
    # alongside the new token, still routing traffic to the provider you just
    # left. Absent -> deleted, never inherited from the layer below.
    # reduce, not iteration, so this stays one document however many keys move.
    | reduce ($provider_keys[]) as $k (.;
        if ($prov | has($k)) then .[$k] = $prov[$k] else del(.[$k]) end)
    ' > "$out"
}

activate() {
  local p="$1"
  ensure_provider_file "$p"
  mkdir -p "$PDIR"

  # Refuse rather than write an unguarded settings.json. Shipping a safety
  # control that silently is not there is the failure mode this whole merge
  # exists to end, so a missing merge tool must be loud.
  command -v jq >/dev/null 2>&1 \
    || die "jq is required to merge settings.json safely (install jq, then re-run: ccs $p)"
  [ -f "$BASE_SETTINGS" ] \
    || die "missing $BASE_SETTINGS; re-run install.sh to restore the repo-owned safety settings"

  local tmp
  tmp="$(mktemp "$CLAUDE_DIR/.settings.json.XXXXXX")"
  if ! merge_settings "$PDIR/$p.json" "$tmp"; then
    rm -f "$tmp"
    die "failed to merge providers/$p.json into settings.json; settings.json is unchanged"
  fi
  # Written whole, then swapped: a half-written settings.json is a broken
  # Claude Code, and this file is read at startup.
  chmod 600 "$tmp"
  mv -f "$tmp" "$SETTINGS"

  printf '%s\n' "$p" > "$PDIR/.active"
  printf 'Active provider: %s\n' "$p"
  if [ "$p" = "codex" ]; then
    start_codex_gateway
    refresh_codex_model_discovery
    tmp="$(mktemp "$CLAUDE_DIR/.settings.json.XXXXXX")"
    if merge_settings "$PDIR/$p.json" "$tmp"; then
      chmod 600 "$tmp"
      mv -f "$tmp" "$SETTINGS"
    else
      rm -f "$tmp"
      die "failed to refresh Codex model discovery settings; settings.json is unchanged"
    fi
  else
    warn_if_local_endpoint_down "$p"
  fi
  printf 'Restart Claude Code for the change to take effect (env is read at startup).\n'
}

status() {
  local active
  if [ -f "$PDIR/.active" ]; then
    active=$(cat "$PDIR/.active")
  else
    printf 'none (provider system not active; settings.json is whatever install.sh seeded)\n'
    return
  fi
  printf '%s\n' "$active"
  provider_auth_status "$active" >&2
  # Surface the common footgun: settings.json is a COPY, so editing the
  # provider file (or a stale switch) leaves it out of sync and you get a
  # silent 401. Warn on stderr so `ccs status` script output stays clean.
  if [ -f "$PDIR/$active.json" ]; then
    # settings.json is a MERGE now, so a byte compare against the provider file
    # would always report drift. Recompute the merge and compare against that:
    # this still catches the original footgun (an edited provider file that was
    # never re-activated, giving a silent 401) and additionally catches an
    # edited settings.base.json whose safety rules have not been applied yet.
    if [ -f "$SETTINGS" ] && command -v jq >/dev/null 2>&1 && [ -f "$BASE_SETTINGS" ]; then
      local expected
      expected="$(mktemp "${TMPDIR:-/tmp}/cc-provider.XXXXXX")"
      if merge_settings "$PDIR/$active.json" "$expected" 2>/dev/null \
         && ! jq -e --slurpfile a "$expected" --slurpfile b "$SETTINGS" \
                 -n '$a[0] == $b[0]' >/dev/null 2>&1; then
        printf 'WARNING: settings.json is out of date with providers/%s.json or settings.base.json - re-run: ccs %s\n' "$active" "$active" >&2
      fi
      rm -f "$expected"
    fi
    if grep -qE "$PLACEHOLDER_RE" "$PDIR/$active.json" 2>/dev/null; then
      printf 'WARNING: providers/%s.json still has a placeholder (<...>) - fill your token, then: ccs %s\n' "$active" "$active" >&2
    fi
    warn_if_local_endpoint_down "$active"
  fi
}


doctor() {
  local active expected deny_count hook_count
  printf 'Provider doctor\n'
  command -v jq >/dev/null 2>&1 && printf 'jq: ok\n' || printf 'jq: missing (provider switching cannot merge safely)\n'
  [ -f "$BASE_SETTINGS" ] && printf 'settings.base.json: present\n' || printf 'settings.base.json: missing\n'
  if [ -f "$PDIR/.active" ]; then
    active=$(cat "$PDIR/.active")
    printf 'active provider: %s\n' "$active"
    provider_auth_status "$active"
    if [ -f "$PDIR/$active.json" ] && [ -f "$SETTINGS" ] && command -v jq >/dev/null 2>&1 && [ -f "$BASE_SETTINGS" ]; then
      expected="$(mktemp "${TMPDIR:-/tmp}/cc-provider-doctor.XXXXXX")"
      if merge_settings "$PDIR/$active.json" "$expected" 2>/dev/null \
         && jq -e --slurpfile a "$expected" --slurpfile b "$SETTINGS" -n '$a[0] == $b[0]' >/dev/null 2>&1; then
        printf 'settings.json: matches active provider merge\n'
      else
        printf 'settings.json: drifted (run: ccs use %s)\n' "$active"
      fi
      rm -f "$expected"
    fi
    warn_if_local_endpoint_down "$active"
  else
    printf 'active provider: none\n'
  fi
  if [ -f "$SETTINGS" ] && command -v jq >/dev/null 2>&1; then
    deny_count=$(jq -r '(.permissions.deny // []) | length' "$SETTINGS" 2>/dev/null || printf '0')
    hook_count=$(jq -r '[.hooks[]?[]?.hooks[]?] | length' "$SETTINGS" 2>/dev/null || printf '0')
    printf 'safety deny rules: %s\n' "$deny_count"
    printf 'hook handlers: %s\n' "$hook_count"
  fi
  status_codex_gateway
  codex_picker_status
  if [ -f "$PDIR/nvidia.json" ] || [ -f "$PDIR/nvidia.json.example" ] || [ -f "$CLAUDE_DIR/scripts/nim-gateway.sh" ]; then
    printf 'gateway check: '
    if [ -f "$PDIR/nvidia.json" ]; then
      printf 'nvidia provider present\n'
      warn_if_local_endpoint_down nvidia
    else
      printf 'nvidia template present\n'
    fi
  fi
}

usage() {
  printf 'usage: cc-provider [list|status|doctor|models|account|usage|model <model> [effort]|use <provider>|auth <provider>|login <provider>|api <provider>|logout <provider>|codex-start|codex-stop|codex-status|codex-model <model> [effort]|<provider>]\n' >&2
  printf '  list              list available providers\n' >&2
  printf '  status            print the active provider (default) and auth summary on stderr\n' >&2
  printf '  use <provider>    activate it (compatibility shorthand: cc-provider <provider>)\n' >&2
  printf '  auth <provider>   show auth mode or fill an API key when needed\n' >&2
  printf '  login <provider>  fill an API key; codex/chatgpt delegates to official codex login\n' >&2
  printf '  api <provider>    fill an API key in providers/<provider>.json\n' >&2
  printf '  logout <provider> clear a local API key; codex/chatgpt delegates to codex logout\n' >&2
  printf '  doctor            check provider setup, safety merge and local gateway state\n' >&2
  printf '  models            list live Codex models from the local gateway catalog\n' >&2
  printf '  account           show supported Codex account/auth details\n' >&2
  printf '  usage             show supported Codex usage and rate-limit details\n' >&2
  printf '  model             set Codex model id and reasoning effort (alias: codex-model)\n' >&2
  printf '  codex-start       start the local Codex app-server gateway\n' >&2
  printf '  codex-stop        stop the local Codex app-server gateway\n' >&2
  printf '  codex-status      print Codex gateway state and selected model\n' >&2
  printf '  codex-model       set Codex model id and reasoning effort (default: medium)\n' >&2
  printf '\navailable providers:\n' >&2
  local p
  for p in $(list_providers); do printf '  %s\n' "$p" >&2; done
}

cmd="${1:-status}"
case "$cmd" in
  status)    [ "${2:-}" = "" ] || die "status accepts no provider argument"; status ;;
  list)      [ "${2:-}" = "" ] || die "list accepts no provider argument"; list_providers ;;
  doctor)    [ "${2:-}" = "" ] || die "doctor accepts no provider argument"; doctor ;;
  models)    [ "${2:-}" = "" ] || die "models accepts no arguments"; list_codex_models ;;
  account)   [ "${2:-}" = "" ] || die "account accepts no arguments"; print_codex_account ;;
  usage)     [ "${2:-}" = "" ] || die "usage accepts no arguments"; print_codex_usage ;;
  model)     set_codex_model "${2:-}" "${3:-medium}"; [ "${4:-}" = "" ] || die "model accepts at most model and effort" ;;
  codex-start) [ "${2:-}" = "" ] || die "codex-start accepts no arguments"; start_codex_gateway ;;
  codex-stop) [ "${2:-}" = "" ] || die "codex-stop accepts no arguments"; stop_codex_gateway ;;
  codex-status) [ "${2:-}" = "" ] || die "codex-status accepts no arguments"; status_codex_gateway ;;
  codex-model) set_codex_model "${2:-}" "${3:-medium}"; [ "${4:-}" = "" ] || die "codex-model accepts at most model and effort" ;;
  use)       need_provider_arg use "${2:-}" "${3:-}"; is_provider "$2" || die "unknown provider: $2"; activate "$2" ;;
  auth)
    need_provider_arg auth "${2:-}" "${3:-}"
    if is_codex_entitlement "$2"; then
      provider_auth_status "$2"
    else
      is_provider "$2" || die "unknown provider: $2"
      ensure_provider_file "$2"
      provider_auth_status "$2"
      key=$(credential_key "$2" || true)
      value=""
      [ -n "$key" ] && value=$(credential_value "$2" "$key")
      case "$value" in ''|\<*) write_api_key "$2" ;; esac
    fi
    ;;
  login)     need_provider_arg login "${2:-}" "${3:-}"; if is_codex_entitlement "$2"; then delegate_codex login; else write_api_key "$2"; fi ;;
  api)       need_provider_arg api "${2:-}" "${3:-}"; write_api_key "$2" ;;
  logout)    need_provider_arg logout "${2:-}" "${3:-}"; logout_provider "$2" ;;
  -h|--help) usage; exit 0 ;;
  '')        usage; exit 1 ;;
  *)
    if is_provider "$cmd"; then
      activate "$cmd"
    else
      printf 'cc-provider: unknown provider or command: %s\n\n' "$cmd" >&2
      usage
      exit 1
    fi
    ;;
esac

#!/usr/bin/env bash
# fkt — FK Claude Toolkit updater.
#
# The bootstrap layer (this repository checked out at ~/.claude) cannot be
# managed by Claude Code's plugin auto-updater: it carries hooks, provider
# scripts, global instructions and the installer itself. `fkt` is the safe
# update path for exactly that layer. Everything under skills/fk-*/ is a plugin
# and should be updated by Claude Code instead — see `fkt status`.
#
# Design rules this script obeys:
#   * It never destroys local work. Updates are fast-forward-only and refuse to
#     run against a dirty or diverged worktree.
#   * It never touches the network unless asked, and never on a cached hit.
#   * It collects nothing and reports nothing anywhere. The only outbound
#     requests are `git ls-remote` against the repository and one static file
#     fetch for security advisories.
#   * It fails open. A broken check must never stop Claude Code from starting.
#
# Exit codes:
#    0  success / already up to date
#    2  usage error
#   10  update available (check mode only)
#   20  refused — local changes or diverged history would be lost
#   30  offline or the remote could not be reached
#   40  this is not a git checkout, so it cannot be updated in place
#   50  a migration failed
#
# Environment overrides (all optional, all documented in docs/updates.md):
#   FKT_HOME         toolkit checkout                (default ~/.claude)
#   FKT_CONFIG_DIR   config dir                      (default XDG config/fk-toolkit)
#   FKT_STATE_DIR    state dir                       (default XDG state/fk-toolkit)
#   FKT_CHANNEL      stable | edge                   (overrides config)
#   FKT_UPDATE_CHECK 0 disables update checks entirely
#   FKT_SECURITY_NOTICES 0 disables the advisory fetch
#   FKT_GSTACK_UPDATE 0 skips the skills/gstack fast-forward during `fkt update`
#   FKT_OFFLINE      1 forbids all network access
#   FKT_ADVISORY_URL_BASE  base URL for the advisory feed (testing/air-gapped)
#   FKT_MCP_LIVE_CHECK 0 skips live claude/codex MCP CLI inspection
#   FKT_CLAUDE_BIN, FKT_CODEX_BIN  host CLI overrides for MCP diagnostics
#   FKT_CHECK_TTL_MINUTES, FKT_SNOOZE_HOURS  cache tuning (testing)

set -euo pipefail

FKT_VERSION_SCHEMA=1

FKT_HOME="${FKT_HOME:-$HOME/.claude}"
FKT_CONFIG_DIR="${FKT_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/fk-toolkit}"
FKT_STATE_DIR="${FKT_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/fk-toolkit}"

CONFIG_FILE="$FKT_CONFIG_DIR/config"
CHECK_CACHE="$FKT_STATE_DIR/update-check"
SNOOZE_FILE="$FKT_STATE_DIR/snooze"
ADVISORY_CACHE="$FKT_STATE_DIR/advisories.tsv"
MIGRATION_DIR="$FKT_STATE_DIR/migrations"
MCP_REGISTRY="$FKT_HOME/mcp-registry.toml"
MCP_MANIFEST="$FKT_HOME/skills/fk-toolkit-ops/mcp.json"
CLAUDE_BIN="${FKT_CLAUDE_BIN:-claude}"
CODEX_BIN="${FKT_CODEX_BIN:-codex}"

DEFAULT_CHANNEL="stable"
DEFAULT_TTL_MINUTES=720            # 12h; a config repo does not move hourly
# Overridable so tests (and air-gapped installs) can point the feed somewhere
# local instead of reaching for the network. Any curl-supported URL works,
# including file://.
ADVISORY_URL_BASE="${FKT_ADVISORY_URL_BASE:-https://raw.githubusercontent.com/furkankoykiran/.claude}"

# Exit codes as names, so callers and tests read clearly.
EX_USAGE=2
EX_UPDATE_AVAILABLE=10
EX_REFUSED=20
EX_OFFLINE=30
EX_NOT_GIT=40
EX_MIGRATION=50

say()  { printf '%s\n' "$*"; }
info() { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m!!\033[0m %s\n' "$*" >&2; }
err()  { printf '\033[1;31mxx\033[0m %s\n' "$*" >&2; }

# ---------------------------------------------------------------------------
# Config
# ---------------------------------------------------------------------------
# A flat key=value file rather than JSON: no parser dependency, greppable, and a
# user can see at a glance what the updater will do. Unknown keys are ignored so
# a newer toolkit can add keys without breaking an older fkt.
config_get() {
  local key="$1" default="${2-}" line
  if [ -f "$CONFIG_FILE" ]; then
    # Last assignment wins; tolerate whitespace and comments.
    line="$(sed -n "s/^[[:space:]]*${key}[[:space:]]*=[[:space:]]*\(.*\)$/\1/p" "$CONFIG_FILE" | tail -1)"
    line="${line%%#*}"
    # Trim trailing whitespace.
    line="${line%"${line##*[![:space:]]}"}"
    if [ -n "$line" ]; then printf '%s\n' "$line"; return 0; fi
  fi
  printf '%s\n' "$default"
}

config_set() {
  local key="$1" value="$2" tmp
  mkdir -p "$FKT_CONFIG_DIR"
  tmp="$(mktemp "$FKT_CONFIG_DIR/.config.XXXXXX")"
  if [ -f "$CONFIG_FILE" ]; then
    grep -v "^[[:space:]]*${key}[[:space:]]*=" "$CONFIG_FILE" > "$tmp" || true
  else
    {
      say "# fk-toolkit updater configuration."
      say "# Written by \`fkt\`; safe to edit by hand. See docs/updates.md."
    } > "$tmp"
  fi
  printf '%s = %s\n' "$key" "$value" >> "$tmp"
  chmod 600 "$tmp"
  mv -f "$tmp" "$CONFIG_FILE"
}

channel() {
  local c="${FKT_CHANNEL:-$(config_get channel "$DEFAULT_CHANNEL")}"
  case "$c" in
    stable|edge) printf '%s\n' "$c" ;;
    *) warn "unknown channel \"$c\"; falling back to $DEFAULT_CHANNEL"; printf '%s\n' "$DEFAULT_CHANNEL" ;;
  esac
}

ttl_minutes() {
  local t="${FKT_CHECK_TTL_MINUTES:-$(config_get check_ttl_minutes "$DEFAULT_TTL_MINUTES")}"
  case "$t" in (''|*[!0-9]*) t="$DEFAULT_TTL_MINUTES" ;; esac
  printf '%s\n' "$t"
}

checks_enabled() {
  [ "${FKT_UPDATE_CHECK:-1}" != "0" ] || return 1
  [ "$(config_get update_check true)" != "false" ] || return 1
  return 0
}

advisories_enabled() {
  [ "${FKT_SECURITY_NOTICES:-1}" != "0" ] || return 1
  [ "$(config_get security_notices true)" != "false" ] || return 1
  return 0
}

offline() { [ "${FKT_OFFLINE:-0}" = "1" ]; }

# ---------------------------------------------------------------------------
# Repository facts
# ---------------------------------------------------------------------------
is_git_checkout() { [ -d "$FKT_HOME/.git" ]; }

git_at() { git -C "$FKT_HOME" "$@"; }

installed_version() {
  if [ -f "$FKT_HOME/VERSION" ]; then
    tr -d '[:space:]' < "$FKT_HOME/VERSION"
  else
    printf 'unknown\n'
  fi
}

remote_url() {
  git_at config --get remote.origin.url 2>/dev/null || printf '\n'
}

# Highest v-prefixed semver tag on the remote. Read with ls-remote so a check
# never mutates the local repository.
remote_latest_tag() {
  local out
  out="$(GIT_TERMINAL_PROMPT=0 git_at ls-remote --tags --refs origin 'v*' 2>/dev/null)" || return 1
  printf '%s\n' "$out" \
    | sed 's#.*refs/tags/##' \
    | grep -E '^v[0-9]+\.[0-9]+\.[0-9]+$' \
    | sort -V \
    | tail -1
}

remote_main_sha() {
  GIT_TERMINAL_PROMPT=0 git_at ls-remote origin refs/heads/main 2>/dev/null | awk 'NR==1{print $1}'
}

# semver compare: prints "newer" if $2 > $1, else "same-or-older".
version_newer() {
  local have="$1" want="$2"
  [ "$have" = "$want" ] && { printf 'same-or-older\n'; return 0; }
  # sort -V puts the greater last; if that is $want, $want is newer.
  if [ "$(printf '%s\n%s\n' "$have" "$want" | sort -V | tail -1)" = "$want" ]; then
    printf 'newer\n'
  else
    printf 'same-or-older\n'
  fi
}

# ---------------------------------------------------------------------------
# Cache + snooze
# ---------------------------------------------------------------------------
# Cache line: "<status> <current> <latest> <epoch>"
#   status: UP_TO_DATE | UPDATE_AVAILABLE | UNKNOWN
write_cache() {
  local status="$1" current="$2" latest="$3" tmp
  mkdir -p "$FKT_STATE_DIR"
  tmp="$(mktemp "$FKT_STATE_DIR/.update-check.XXXXXX")"
  printf '%s %s %s %s\n' "$status" "$current" "$latest" "$(date +%s)" > "$tmp"
  mv -f "$tmp" "$CHECK_CACHE"
}

cache_fresh() {
  [ -f "$CHECK_CACHE" ] || return 1
  [ -z "$(find "$CHECK_CACHE" -mmin "+$(ttl_minutes)" 2>/dev/null)" ]
}

cache_field() {
  [ -f "$CHECK_CACHE" ] || return 1
  awk -v n="$1" 'NR==1{print $n}' "$CHECK_CACHE"
}

# A cached verdict describes one specific install, and nothing invalidates it
# when the checkout moves: `fkt update`, a plain `git pull`, or re-running
# install.sh over the top all change VERSION without touching this file. Field 2
# records the version that was installed when the line was written, and until
# now nothing ever read it back — so a record could outlive its install and keep
# asserting an update that had already landed. That is how a "0.3.0 -> 0.3.1"
# notice reached a 0.4.1 checkout, for a 0.3.1 that was never even released.
#
# Validation is local: VERSION is a file read, so this costs no network.
cache_valid_for() {
  local current="$1" ch="$2" recorded latest
  recorded="$(cache_field 2 2>/dev/null || true)"
  latest="$(cache_field 3 2>/dev/null || true)"
  # A truncated or garbled line leaves these empty; treat it as no cache at all.
  [ -n "$recorded" ] && [ -n "$latest" ] || return 1
  [ "$recorded" = "$current" ] || return 1
  # An UPDATE_AVAILABLE whose target the checkout has already reached
  # contradicts itself. Both channels can answer that without the network.
  if [ "$(cache_field 1 2>/dev/null || true)" = "UPDATE_AVAILABLE" ]; then
    if [ "$ch" = "stable" ]; then
      [ "$current" = "unknown" ] || [ "$(version_newer "$current" "$latest")" = "newer" ] || return 1
    else
      # On edge the target is a commit, and "do we already contain it" is a
      # local question: --is-ancestor reads the object database, not the remote,
      # and counts a commit as its own ancestor. This matters because most edge
      # commits leave VERSION alone, so the recorded-version test above cannot
      # catch a record the checkout has since caught up with. A sha git does not
      # have errors out non-zero, which correctly leaves the record standing.
      local sha="${latest#edge-}"
      ! git_at merge-base --is-ancestor "$sha" HEAD 2>/dev/null || return 1
    fi
  fi
  return 0
}

snoozed_for() {
  # Snooze is per target version: a newer release always breaks through.
  local version="$1" until_epoch snoozed_version
  [ -f "$SNOOZE_FILE" ] || return 1
  snoozed_version="$(awk 'NR==1{print $1}' "$SNOOZE_FILE")"
  until_epoch="$(awk 'NR==1{print $2}' "$SNOOZE_FILE")"
  case "$until_epoch" in (''|*[!0-9]*) return 1 ;; esac
  [ "$snoozed_version" = "$version" ] || return 1
  [ "$(date +%s)" -lt "$until_epoch" ]
}

# ---------------------------------------------------------------------------
# Security advisories
# ---------------------------------------------------------------------------
# A tab-separated file in the repository, fetched from the default branch so an
# advisory reaches installs pinned to an old release. Deliberately not JSON: no
# parser dependency, and a user can read it with `cat`.
#
#   id <TAB> severity <TAB> introduced <TAB> fixed <TAB> summary <TAB> url
#
# `fixed` may be "-" for an unfixed advisory. Lines starting with # are comments.
fetch_advisories() {
  advisories_enabled || return 0
  offline && return 0
  command -v curl >/dev/null 2>&1 || return 0
  local tmp
  mkdir -p "$FKT_STATE_DIR"
  tmp="$(mktemp "$FKT_STATE_DIR/.advisories.XXXXXX")"
  if curl -fsSL --max-time 8 --retry 1 \
       "$ADVISORY_URL_BASE/main/security-advisories.tsv" -o "$tmp" 2>/dev/null \
     && looks_like_advisory_feed "$tmp"; then
    mv -f "$tmp" "$ADVISORY_CACHE"
  else
    rm -f "$tmp"
  fi
  return 0
}

# Only replace the cache with something that is actually an advisory feed. A
# captive portal, a proxy error page or a repository rename can all answer 200
# with HTML; installing that would silently blind the advisory check.
looks_like_advisory_feed() {
  local file="$1"
  [ -s "$file" ] || return 1
  local first
  IFS= read -r first < "$file" || return 1
  case "$first" in '#'*) ;; *) return 1 ;; esac
  # Every non-comment line must have the six tab-separated columns.
  ! awk -F'\t' '!/^#/ && NF > 0 && NF != 6 { found = 1 } END { exit !found }' "$file"
}

# Print advisories that apply to $1 (the installed version).
applicable_advisories() {
  local current="$1"
  [ -f "$ADVISORY_CACHE" ] || return 0
  [ "$current" = "unknown" ] && return 0
  awk -F'\t' -v cur="$current" '
    function vnum(v,   a, n) { n = split(v, a, "."); return (a[1]*1000000) + (a[2]*1000) + a[3] }
    /^#/ || NF < 5 { next }
    {
      intro = $3; fixed = $4
      if (intro != "-" && vnum(cur) < vnum(intro)) next
      if (fixed != "-" && vnum(cur) >= vnum(fixed)) next
      printf "%s\t%s\t%s\t%s\n", $1, $2, $5, ($6 == "" ? "-" : $6)
    }
  ' "$ADVISORY_CACHE"
}

# Machine-readable form of the same list `print_advisories` renders. The
# SessionStart hook needs the data, not the presentation: `warn` writes to
# stderr and colours every line, so scraping `fkt status` loses the advisories
# to the wrong stream and to escape codes. Both sides share
# `applicable_advisories`, so version matching is defined in exactly one place.
do_advisories() {
  advisories_enabled || return 0
  applicable_advisories "$(installed_version)"
}

print_advisories() {
  local current="$1" out
  # Gate on the setting here, not only in fetch_advisories: turning notices off
  # must silence the cached file too, otherwise `security_notices = false` only
  # stops future downloads and keeps printing whatever was already on disk.
  advisories_enabled || return 0
  out="$(applicable_advisories "$current")" || return 0
  [ -n "$out" ] || return 0
  printf '\n'
  warn "security advisories affecting $current:"
  printf '%s\n' "$out" | while IFS=$'\t' read -r id severity summary url; do
    warn "  [$severity] $id — $summary"
    [ "$url" != "-" ] && warn "        $url"
  done
  warn "Run 'fkt update' to move to a fixed version."
}

# ---------------------------------------------------------------------------
# check
# ---------------------------------------------------------------------------
do_check() {
  local force=0 quiet=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --force) force=1 ;;
      --quiet) quiet=1 ;;
      *) err "unknown argument to check: $1"; return "$EX_USAGE" ;;
    esac
    shift
  done

  if ! checks_enabled && [ "$force" -eq 0 ]; then
    [ "$quiet" -eq 1 ] || say "update checks are disabled (update_check = false)"
    return 0
  fi
  if ! is_git_checkout; then
    [ "$quiet" -eq 1 ] || err "$FKT_HOME is not a git checkout; nothing to check"
    return "$EX_NOT_GIT"
  fi

  local current ch
  current="$(installed_version)"
  ch="$(channel)"

  if [ "$force" -eq 0 ] && cache_fresh && ! cache_valid_for "$current" "$ch"; then
    # Written for a different install than the one running now. Drop it rather
    # than replay it, and answer "nothing to report" instead of reaching for the
    # remote: this path runs inside the SessionStart hook, which must never
    # block startup on IO. Deleting the record makes the next cache_fresh test
    # fail, so the hook's own detached refresh rebuilds it for the next session.
    # That costs one background fetch per version change, not one per startup.
    local stale_for stale_line
    stale_for="$(cache_field 2 2>/dev/null || true)"
    stale_line="$(head -n 1 "$CHECK_CACHE" 2>/dev/null || true)"
    # Discard only the exact record that was judged. write_cache is atomic, so a
    # concurrent refresh either has not landed yet or has landed whole; re-reading
    # first keeps this from deleting a good record that arrived in between and
    # costing the next session a needless fetch.
    if [ "$stale_line" = "$(head -n 1 "$CHECK_CACHE" 2>/dev/null || true)" ]; then
      rm -f "$CHECK_CACHE"
    fi
    [ "$quiet" -eq 1 ] || say "discarded a cached check written for ${stale_for:-an unknown version} (installed: $current)"
    return 0
  fi

  if [ "$force" -eq 0 ] && cache_fresh; then
    local status latest
    status="$(cache_field 1)"
    latest="$(cache_field 3)"
    if [ "$status" = "UPDATE_AVAILABLE" ]; then
      if snoozed_for "$latest"; then
        [ "$quiet" -eq 1 ] || say "update $latest available (snoozed)"
        return 0
      fi
      [ "$quiet" -eq 1 ] || say "update available: $current -> $latest ($ch)"
      return "$EX_UPDATE_AVAILABLE"
    fi
    [ "$quiet" -eq 1 ] || say "up to date ($current, $ch, cached)"
    return 0
  fi

  if offline; then
    [ "$quiet" -eq 1 ] || warn "offline (FKT_OFFLINE=1); keeping the cached result"
    return "$EX_OFFLINE"
  fi

  local latest=""
  if [ "$ch" = "stable" ]; then
    latest="$(remote_latest_tag || true)"
    latest="${latest#v}"
  else
    local sha
    sha="$(remote_main_sha || true)"
    [ -n "$sha" ] && latest="edge-${sha:0:12}"
  fi

  if [ -z "$latest" ]; then
    write_cache UNKNOWN "$current" "-"
    [ "$quiet" -eq 1 ] || warn "could not reach $(remote_url); leaving the cache marked unknown"
    return "$EX_OFFLINE"
  fi

  fetch_advisories

  local newer="same-or-older"
  if [ "$ch" = "stable" ]; then
    [ "$current" != "unknown" ] && newer="$(version_newer "$current" "$latest")"
  else
    # On edge the comparison is by commit: an update exists when the remote head
    # is not already an ancestor of HEAD.
    local sha="${latest#edge-}"
    if git_at merge-base --is-ancestor "$sha" HEAD 2>/dev/null; then
      newer="same-or-older"
    else
      newer="newer"
    fi
  fi

  if [ "$newer" = "newer" ]; then
    write_cache UPDATE_AVAILABLE "$current" "$latest"
    if snoozed_for "$latest"; then
      [ "$quiet" -eq 1 ] || say "update $latest available (snoozed)"
      return 0
    fi
    [ "$quiet" -eq 1 ] || say "update available: $current -> $latest ($ch)"
    [ "$quiet" -eq 1 ] || print_advisories "$current"
    return "$EX_UPDATE_AVAILABLE"
  fi

  write_cache UP_TO_DATE "$current" "$latest"
  [ "$quiet" -eq 1 ] || say "up to date ($current, $ch)"
  [ "$quiet" -eq 1 ] || print_advisories "$current"
  return 0
}

# ---------------------------------------------------------------------------
# update
# ---------------------------------------------------------------------------
# Refuses rather than repairs. Every failure mode here (dirty tree, diverged
# history, detached HEAD) means the user has work the updater must not touch.
assert_updatable() {
  is_git_checkout || { err "$FKT_HOME is not a git checkout; re-run install.sh instead"; return "$EX_NOT_GIT"; }

  if [ -n "$(git_at status --porcelain --untracked-files=no 2>/dev/null)" ]; then
    err "refusing to update: $FKT_HOME has uncommitted changes to tracked files."
    err "Review them with 'git -C $FKT_HOME status', then commit or stash and re-run."
    return "$EX_REFUSED"
  fi

  local branch
  branch="$(git_at symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
  if [ -z "$branch" ]; then
    err "refusing to update: $FKT_HOME is on a detached HEAD."
    err "Check out a branch first: git -C $FKT_HOME checkout main"
    return "$EX_REFUSED"
  fi
  return 0
}

# First 20 commits of HEAD..<sha>, without a pipe. `git log | head` is the same
# SIGPIPE-under-pipefail trap as the tag list above, and here the left-hand side
# can be arbitrarily long.
log_range() {
  local out
  out="$(git_at log --oneline -n 20 "HEAD..$1" 2>/dev/null)" || return 0
  [ -n "$out" ] && printf '%s\n' "$out"
  return 0
}

resolve_target() {
  # Prints the ref to fast-forward to for the active channel.
  local ch="$1"
  if [ "$ch" = "stable" ]; then
    local tags tag
  # Capture, then take the first line. `git tag --list ... | head -1` looks
  # harmless but races under `set -o pipefail`: head exits after one line, git's
  # next write takes SIGPIPE, the pipeline reports 141, and `set -e` kills the
  # script with NO message. Reproduced at ~1,000 tags (8/10 runs) - and this
  # repository grows a tag on every release.
    tags="$(git_at tag --list 'v*' --sort=-v:refname 2>/dev/null)" || return 1
    tag="${tags%%$'\n'*}"
    [ -n "$tag" ] || return 1
    printf '%s\n' "$tag"
  else
    git_at rev-parse --verify --quiet origin/main >/dev/null 2>&1 || return 1
    printf 'origin/main\n'
  fi
}

# ---------------------------------------------------------------------------
# gstack
# ---------------------------------------------------------------------------
# skills/gstack falls through every update path this machine has. It is not part
# of this repository's history and it is not a Claude Code plugin — it is an
# independent checkout of garrytan/gstack with its own upstream, VERSION and
# ./setup. So `fkt update` skipped it, the plugin updater skipped it, and it
# only ever moved when someone remembered to run /gstack-upgrade by hand.
#
# That cost 11 days of broken AskUserQuestion on this install: gstack's
# question-preference-hook returned permissionDecision 'defer' on its
# pass-through path, which since Claude Code 2.1.89 means "pause for external
# resumption" rather than "no opinion". Nothing resumed it, so every call was
# backfilled as "[Tool result missing due to internal error]". The fix was two
# commits upstream the whole time.
#
# This deliberately does NOT shell out to /gstack-upgrade, which runs
# `git stash && git fetch && git reset --hard origin/main`. A hard reset of a
# third-party checkout has no place inside `fkt update`, whose first design rule
# is that it never destroys local work. Fast-forward or nothing.
#
# Fails open in every branch: a gstack problem must never fail `fkt update`,
# so this returns 0 unconditionally.
gstack_git() { git -C "$FKT_HOME/skills/gstack" "$@"; }

gstack_version() {
  if [ -f "$FKT_HOME/skills/gstack/VERSION" ]; then
    tr -d '[:space:]' < "$FKT_HOME/skills/gstack/VERSION"
  else
    printf 'unknown\n'
  fi
}

do_gstack_update() {
  local dry_run="${1:-0}"
  local dir="$FKT_HOME/skills/gstack"

  # Not installed. Silent: a toolkit without gstack is a supported layout, not
  # a problem to report on every update.
  [ -d "$dir/.git" ] || return 0

  [ "${FKT_GSTACK_UPDATE:-1}" != "0" ] || return 0
  if offline; then
    return 0
  fi

  if ! GIT_TERMINAL_PROMPT=0 gstack_git fetch --quiet --prune origin 2>/dev/null; then
    warn "gstack: could not reach its remote; leaving it at $(gstack_version)"
    return 0
  fi

  local head target
  head="$(gstack_git rev-parse --verify HEAD 2>/dev/null || true)"
  target="$(gstack_git rev-parse --verify --quiet origin/main 2>/dev/null || true)"
  if [ -z "$head" ] || [ -z "$target" ]; then
    warn "gstack: could not resolve HEAD or origin/main; skipping"
    return 0
  fi
  [ "$head" = "$target" ] && return 0

  # Refuse rather than repair, exactly as the bootstrap layer does. Both of
  # these mean the user has work here that only /gstack-upgrade is allowed to
  # discard, and then only because the user asked it to.
  if [ -n "$(gstack_git status --porcelain --untracked-files=no 2>/dev/null)" ]; then
    warn "gstack: skipping update, $dir has uncommitted changes."
    warn "Run '/gstack-upgrade' inside Claude Code to update it anyway (it discards them)."
    return 0
  fi
  if ! gstack_git merge-base --is-ancestor "$head" "$target" 2>/dev/null; then
    warn "gstack: skipping update, $dir has local commits that are not on origin/main."
    warn "Run '/gstack-upgrade' inside Claude Code to update it anyway (it discards them)."
    return 0
  fi

  local before after
  before="$(gstack_version)"

  # `--dry-run` must not write anything, and here "writing" includes executing
  # gstack's ./setup — downloaded third-party code. The bootstrap dry-run check
  # sits further down do_update(), so without this a dry run against an
  # already-current toolkit would reach this point and really update gstack.
  if [ "$dry_run" -eq 1 ]; then
    say "would fast-forward gstack $before -> $(gstack_git show "$target:VERSION" 2>/dev/null | tr -d '[:space:]' || printf 'unknown')"
    return 0
  fi

  # --no-overwrite-ignore: git will happily clobber an IGNORED file when the
  # incoming commit starts tracking that path, and --ff-only does not change
  # that. gstack checkouts carry ignored local state, and silently overwriting
  # it is exactly the kind of loss this updater promises never to cause.
  if ! gstack_git merge --ff-only --no-overwrite-ignore --quiet "$target" 2>/dev/null; then
    warn "gstack: fast-forward refused or failed; nothing was changed (still $before)"
    warn "If it names an untracked or ignored file, move it aside and re-run."
    return 0
  fi

  # A bare fast-forward is not enough: setup relinks gstack's skills and
  # rebuilds its binaries, so skipping it leaves the checkout ahead of what is
  # actually wired into Claude Code.
  if ! (cd "$dir" && ./setup --no-prefix >/dev/null 2>&1); then
    after="$(gstack_version)"
    warn "gstack: updated $before -> $after but './setup --no-prefix' failed."
    warn "Re-run it by hand: cd $dir && ./setup --no-prefix"
    return 0
  fi

  after="$(gstack_version)"
  info "gstack updated $before -> $after"
  return 0
}

do_update() {
  local assume_yes=0 dry_run=0
  while [ $# -gt 0 ]; do
    case "$1" in
      -y|--yes) assume_yes=1 ;;
      --dry-run) dry_run=1 ;;
      *) err "unknown argument to update: $1"; return "$EX_USAGE" ;;
    esac
    shift
  done

  assert_updatable || return $?

  if offline; then
    err "offline (FKT_OFFLINE=1); cannot fetch an update"
    return "$EX_OFFLINE"
  fi

  local ch before
  ch="$(channel)"
  before="$(installed_version)"

  info "fetching $(remote_url) ($ch)"
  if ! GIT_TERMINAL_PROMPT=0 git_at fetch --quiet --tags --prune origin; then
    err "fetch failed; check the network and try again"
    return "$EX_OFFLINE"
  fi

  local target
  if ! target="$(resolve_target "$ch")"; then
    err "no update target found on the $ch channel"
    [ "$ch" = "stable" ] && err "The remote has no v* release tag yet; try 'fkt channel edge'."
    return "$EX_OFFLINE"
  fi

  local target_sha head_sha
  target_sha="$(git_at rev-parse --verify "$target^{commit}")"
  head_sha="$(git_at rev-parse --verify HEAD)"

  if [ "$target_sha" = "$head_sha" ]; then
    say "already at $target ($before)"
    write_cache UP_TO_DATE "$before" "$before"
    do_migrate
    # Also on this path: gstack has its own upstream and moves independently of
    # the bootstrap layer, so a no-op `fkt update` must still keep it current.
    # Skipping it here is how a fix sat two commits away for eleven days.
    do_gstack_update "$dry_run"
    return 0
  fi

  # Fast-forward only. If HEAD is not an ancestor of the target, the local
  # checkout carries commits the update would discard.
  if ! git_at merge-base --is-ancestor HEAD "$target_sha" 2>/dev/null; then
    err "refusing to update: $FKT_HOME has local commits that are not on $target."
    err "This update would discard them. Inspect with:"
    err "  git -C $FKT_HOME log --oneline $target_sha..HEAD"
    err "Then rebase or move them to a branch, and re-run 'fkt update'."
    return "$EX_REFUSED"
  fi

  if [ "$dry_run" -eq 1 ]; then
    say "would fast-forward $(git_at rev-parse --short HEAD) -> $(git_at rev-parse --short "$target_sha") ($target)"
    log_range "$target_sha"
    do_gstack_update 1
    return 0
  fi

  if [ "$assume_yes" -eq 0 ] && [ -t 0 ]; then
    say ""
    say "About to fast-forward $FKT_HOME to $target:"
    log_range "$target_sha"
    say ""
    printf 'Continue? [y/N] '
    local reply=""
    read -r reply || reply=""
    case "$reply" in
      y|Y|yes|YES) ;;
      *) say "aborted"; return 0 ;;
    esac
  fi

  # --no-overwrite-ignore for the same reason as the gstack step above: an
  # ignored local file whose path the incoming commit starts tracking would
  # otherwise be silently overwritten, which this updater must never do.
  if ! git_at merge --ff-only --no-overwrite-ignore --quiet "$target_sha"; then
    err "fast-forward failed; nothing was changed"
    err "If it names an untracked or ignored file, move it aside and re-run."
    return "$EX_REFUSED"
  fi

  local after
  after="$(installed_version)"
  info "updated $before -> $after ($target)"
  write_cache UP_TO_DATE "$after" "$after"
  rm -f "$SNOOZE_FILE"

  do_migrate || return $?
  do_gstack_update

  say ""
  say "Bootstrap layer updated. Two follow-ups:"
  say "  * Restart Claude Code so hooks and instructions reload."
  say "  * Plugins update themselves — run '/plugin marketplace update fk-toolkit'"
  say "    inside Claude Code, or wait for the background check."
  return 0
}

# ---------------------------------------------------------------------------
# migrations
# ---------------------------------------------------------------------------
# Filesystem/config changes that a plugin update cannot express. Each script is
# run at most once, in lexical order, and must be idempotent anyway. A failure
# stops the run and leaves no marker, so the next `fkt migrate` retries it.
do_migrate() {
  local dir="$FKT_HOME/migrations" script id ran=0
  [ -d "$dir" ] || return 0
  mkdir -p "$MIGRATION_DIR"

  for script in "$dir"/[0-9][0-9][0-9][0-9]-*.sh; do
    [ -f "$script" ] || continue
    id="$(basename "$script" .sh)"
    [ -f "$MIGRATION_DIR/$id.done" ] && continue

    info "migration $id"
    if FKT_HOME="$FKT_HOME" FKT_STATE_DIR="$FKT_STATE_DIR" FKT_CONFIG_DIR="$FKT_CONFIG_DIR" \
        bash "$script"; then
      : > "$MIGRATION_DIR/$id.done"
      ran=$((ran + 1))
    else
      err "migration $id failed; no marker written, it will be retried."
      err "Re-run with 'fkt migrate' once the cause is fixed."
      return "$EX_MIGRATION"
    fi
  done

  [ "$ran" -gt 0 ] && info "$ran migration(s) applied"
  return 0
}

# ---------------------------------------------------------------------------
# disk
# ---------------------------------------------------------------------------
# Read-only, and deliberately so. Claude Code already runs a retention sweep at
# startup behind a 24h sentinel (~/.claude/.last-cleanup), gated on
# `cleanupPeriodDays`. It works — so this does not write a second sweeper that
# would race it. What was missing is visibility: nothing said how much the
# toolkit costs, nothing said the setting exists, and the parts core provably
# cannot reach looked identical to the parts it handles every day.
#
# `fkt disk` reports three categories and stops. It never deletes anything, and
# there is no --clean flag: deciding to remove a live venv or a memory
# directory needs a confirmation this cannot ask for.

# Size of a path in KiB, or empty when it does not exist.
disk_kb() {
  [ -e "$1" ] || return 0
  du -sk "$1" 2>/dev/null | awk 'NR==1{print $1}'
}

# KiB -> human. Avoids `du -h` so the number can be compared and totalled.
disk_human() {
  awk -v k="${1:-0}" 'BEGIN {
    if (k >= 1048576) printf "%.1f GiB", k / 1048576
    else if (k >= 1024) printf "%.0f MiB", k / 1024
    else printf "%d KiB", k
  }'
}

disk_row() {
  local label="$1" path="$2" note="${3-}" kb
  kb="$(disk_kb "$path")"
  [ -n "$kb" ] || return 0
  printf '  %-34s %10s  %s\n' "$label" "$(disk_human "$kb")" "$note"
}

# The retention window Claude Code will actually apply. Reported because the
# setting is the single highest-leverage number here and is otherwise invisible:
# it appears in no documentation and in no file this toolkit ships.
disk_cleanup_period() {
  local v=""
  if [ -f "$FKT_HOME/settings.json" ] && command -v jq >/dev/null 2>&1; then
    v="$(jq -r '.cleanupPeriodDays // empty' "$FKT_HOME/settings.json" 2>/dev/null || true)"
  fi
  if [ -n "$v" ]; then
    printf '%s (settings.json)\n' "$v"
  else
    printf '30 (Claude Code default; unset in settings.json)\n'
  fi
}

do_disk() {
  local total
  total="$(disk_kb "$FKT_HOME")"
  say "fk-toolkit disk report — $FKT_HOME"
  say "  total                              $(disk_human "${total:-0}")"
  say "  retention window                   $(disk_cleanup_period)"
  if [ -f "$FKT_HOME/.last-cleanup" ]; then
    say "  last sweep                         $(tr -d '[:space:]' < "$FKT_HOME/.last-cleanup")"
  else
    say "  last sweep                         never recorded"
  fi

  say ""
  say "Swept by Claude Code (no action needed):"
  disk_row "projects/"        "$FKT_HOME/projects"        "transcripts + sidecars"
  disk_row "file-history/"    "$FKT_HOME/file-history"    ""
  disk_row "session-env/"     "$FKT_HOME/session-env"     ""
  disk_row "shell-snapshots/" "$FKT_HOME/shell-snapshots" ""
  disk_row "plans/"           "$FKT_HOME/plans"           ""
  disk_row "debug/"           "$FKT_HOME/debug"           ""
  disk_row "backups/"         "$FKT_HOME/backups"         ""
  disk_row "paste-cache/"     "$FKT_HOME/paste-cache"     ""

  say ""
  say "Never touched (hard-coded, not configurable):"
  disk_row "cache/nim-gateway/"   "$FKT_HOME/cache/nim-gateway"   "live litellm venv"
  disk_row "catalog/cache/"       "$FKT_HOME/catalog/cache"       "git-tracked; offline generate"
  local memkb=0 d
  for d in "$FKT_HOME"/projects/*/memory; do
    [ -d "$d" ] || continue
    memkb=$(( memkb + $(disk_kb "$d") ))
  done
  [ "$memkb" -gt 0 ] && printf '  %-34s %10s  %s\n' "projects/*/memory/" "$(disk_human "$memkb")" "holds MEMORY.md"

  say ""
  say "Outside every sweep (reported only — fkt deletes nothing):"
  # Core sweeps ~/.cache/claude-cli-nodejs only for slugify(cwd), so a slug for
  # a deleted project — or for an ephemeral /tmp scratchpad cwd — is unreachable
  # forever. Upstream: anthropics/claude-code#87678.
  local nodecache="${XDG_CACHE_HOME:-$HOME/.cache}/claude-cli-nodejs"
  if [ -d "$nodecache" ]; then
    local slugs
    slugs="$(find "$nodecache" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l | tr -d ' ')"
    # Deliberately reported as a total, not as "orphaned": a slug for a project
    # that still exists is live data. Which slugs are dead cannot be decided
    # from here without reversing slugify() over paths that may be gone.
    # shellcheck disable=SC2088  # display label, never expanded as a path
    disk_row "~/.cache/claude-cli-nodejs/" "$nodecache" "$slugs slug(s) total; those for deleted projects are unreachable"
  fi
  # Atomic-write leftovers. Each is named .claude.json.tmp.<pid>.<hash>, so
  # whether it is an orphan or a live writer's file is answerable — check the
  # PID rather than claiming every one of them is dead.
  # Upstream: anthropics/claude-code#87677.
  local dead=0 live=0 f pid
  for f in "$HOME"/.claude.json.tmp.*; do
    [ -e "$f" ] || continue
    pid="${f##*.tmp.}"; pid="${pid%%.*}"
    case "$pid" in
      ''|*[!0-9]*) dead=$((dead + 1)) ;;
      *) if kill -0 "$pid" 2>/dev/null; then live=$((live + 1)); else dead=$((dead + 1)); fi ;;
    esac
  done
  # shellcheck disable=SC2088  # display label, never expanded as a path
  [ "$dead" -gt 0 ] && printf '  %-34s %10s  %s\n' "~/.claude.json.tmp.*" "-" "$dead orphan(s) from dead PIDs"
  # shellcheck disable=SC2088  # display label, never expanded as a path
  [ "$live" -gt 0 ] && printf '  %-34s %10s  %s\n' "~/.claude.json.tmp.*" "-" "$live in use by a running process — leave alone"
  # Ours, gitignored, pinned by skills-source.lock.json. Shrink with
  # `git gc --prune=now` per clone rather than by deleting it.
  disk_row ".cache/skill-src/" "$FKT_HOME/.cache/skill-src" "pinned by the lock; git gc to shrink"

  say ""
  say "Lower the retention window to halve the steady-state footprint:"
  say "  set \"cleanupPeriodDays\" in settings.base.json, then re-run 'ccs \$(cat providers/.active)'"
  return 0
}


# ---------------------------------------------------------------------------
# setup UX diagnostics
# ---------------------------------------------------------------------------
do_presets() {
  cat <<'EOF'
Install presets:
  Minimal      repo safety config, provider switcher, updater
  Recommended Minimal plus curated skills, hooks, provider templates, MCP registry
  Full         Recommended plus optional runtimes and broad skill packs
  Custom       choose each install area explicitly

Runtime profiles:
  Safe         manual approvals, compact safety policy, no auto-resume claims
  Balanced     normal toolkit defaults for daily development
  Autonomous   broader tool allowance; review local policy before using
  Long Session  preserve compaction controls and session ergonomics
  Custom       choose model, effort, permissions, compaction, skills and MCPs

These labels are product presets, not hidden magic. Current releases still use
settings.base.json, settings.json.example, providers/*.json and ccs for the
actual merge. See docs/config-sources.md.
EOF
}

do_doctor() {
  local active="none" deny_count="unknown" hook_count="unknown" picker_count="unknown"
  say "fkt doctor"
  say "  checkout        $FKT_HOME$(is_git_checkout || printf ' (not a git checkout)')"
  say "  version         $(installed_version)"
  say "  settings.base   $([ -f "$FKT_HOME/settings.base.json" ] && echo present || echo missing)"
  say "  settings.json   $([ -f "$FKT_HOME/settings.json" ] && echo present || echo missing)"
  say "  provider dir    $([ -d "$FKT_HOME/providers" ] && echo present || echo missing)"
  if [ -f "$FKT_HOME/providers/.active" ]; then
    active="$(tr -d '[:space:]' < "$FKT_HOME/providers/.active")"
  fi
  say "  active provider $active"
  say "  ccs             $([ -x "$FKT_HOME/bin/cc-provider" ] && echo present || echo missing)"
  say "  fkt config      $CONFIG_FILE"
  say "  fkt state       $FKT_STATE_DIR"

  if command -v jq >/dev/null 2>&1 && [ -f "$FKT_HOME/settings.json" ]; then
    deny_count="$(jq -r '(.permissions.deny // []) | length' "$FKT_HOME/settings.json" 2>/dev/null || printf 'unknown')"
    hook_count="$(jq -r '[.hooks[]?[]?.hooks[]?] | length' "$FKT_HOME/settings.json" 2>/dev/null || printf 'unknown')"
    picker_count="$(jq -r '(.modelPicker.options // []) | length' "$FKT_HOME/settings.json" 2>/dev/null || printf 'unknown')"
  fi
  say "  safety denies   $deny_count"
  say "  hooks           $hook_count"
  say "  model picker    $picker_count"

  if [ -r "$MCP_REGISTRY" ]; then
    say "  mcp registry    $(mcp_registry_rows | grep -c .) entries"
  else
    say "  mcp registry    missing"
  fi

  say ""
  say "Read-only check. To rebuild provider settings, run: ccs $(printf '%s' "$active" | sed 's/^none$/<provider>/')"
}


setup_usage() {
  cat <<'EOF'
usage: fkt setup --dry-run [options]
       fkt configure --dry-run [options]
       fkt setup --yes [options]
       fkt configure --yes [options]

Options:
  --preset minimal|recommended|full|custom
  --profile safe|balanced|autonomous|long-session|custom
  --provider NAME
  --model MODEL
  --effort low|medium|high|xhigh|none
  --permission-mode manual|plan|acceptEdits|dontAsk|auto
  --compaction auto|off|tokens
  --updates enabled|disabled
  --auth login|skip
  --skill-pack NAME       repeatable
  --mcp ID                repeatable
  --non-interactive       require all choices to be explicit or defaulted
  --yes                   apply the implemented safe subset

Dry-run writes nothing and never touches credentials. Write mode applies
--updates enabled|disabled to fkt's own config, delegates provider, model,
or authentication changes to ccs, and safely updates documented permission/default compaction
settings after backing up runtime config files. --skill-pack records setup
preferences for later installer/reconfiguration decisions; it does not install or
delete third-party packs. MCP choices and token-window compaction remain
preview-only.
EOF
}

normalize_preset() {
  case "$1" in
    minimal|recommended|full|custom) printf '%s\n' "$1" ;;
    *) return 1 ;;
  esac
}

normalize_profile() {
  case "$1" in
    safe|balanced|autonomous|long-session|custom) printf '%s\n' "$1" ;;
    *) return 1 ;;
  esac
}

normalize_config_id() {
  local raw="$1" normalized
  [ -n "$raw" ] || return 1
  case "$raw" in (*[!A-Za-z0-9._-]*) return 1 ;; esac
  normalized="$(printf '%s' "$raw" | tr '.-' '__')"
  printf '%s\n' "$normalized"
}

backup_file_once() {
  local file="$1" label="$2" stamp backup
  [ -f "$file" ] || return 0
  mkdir -p "$FKT_STATE_DIR/backups"
  stamp="$(date +%Y%m%d%H%M%S)"
  backup="$FKT_STATE_DIR/backups/$label.$stamp.bak"
  cp "$file" "$backup"
  chmod 600 "$backup" 2>/dev/null || true
  say "  backup          $backup"
}

backup_config_file() {
  backup_file_once "$CONFIG_FILE" config
}

backup_runtime_config_files() {
  local provider="$1"
  backup_file_once "$FKT_HOME/settings.json" settings.json
  backup_file_once "$FKT_HOME/providers/.active" providers.active
  [ -n "$provider" ] && backup_file_once "$FKT_HOME/providers/$provider.json" "provider.$provider.json"
}

ccs_command() {
  local ccs="$FKT_HOME/bin/cc-provider"
  [ -x "$ccs" ] || { err "ccs provider switcher not found or not executable: $ccs"; return "$EX_USAGE"; }
  CLAUDE_DIR="$FKT_HOME" "$ccs" "$@"
}

settings_json_update() {
  local tmp src
  command -v jq >/dev/null 2>&1 || { err "jq is required to update settings.json safely"; return "$EX_USAGE"; }
  mkdir -p "$FKT_HOME"
  tmp="$(mktemp "$FKT_HOME/.settings.json.XXXXXX")"
  src="$FKT_HOME/settings.json"
  if [ ! -f "$src" ]; then
    printf '{}\n' > "$tmp.input"
    src="$tmp.input"
  fi
  if ! jq "$@" "$src" > "$tmp"; then
    rm -f "$tmp" "${tmp}.input"
    err "failed to update settings.json; file is unchanged"
    return "$EX_USAGE"
  fi
  rm -f "${tmp}.input"
  chmod 600 "$tmp" 2>/dev/null || true
  mv -f "$tmp" "$FKT_HOME/settings.json"
}

apply_permission_mode_setting() {
  local requested="$1" mode
  case "$requested" in
    manual) mode="default" ;;
    *) mode="$requested" ;;
  esac
  settings_json_update --arg mode "$mode" '.permissions = (.permissions // {}) | .permissions.defaultMode = $mode'
  say "  applied         permission mode $requested"
}

apply_compaction_setting() {
  case "$1" in
    auto)
      settings_json_update '.autoCompactEnabled = true | del(.autoCompactWindow)'
      say "  applied         auto-compaction enabled"
      ;;
    off)
      settings_json_update '.autoCompactEnabled = false | del(.autoCompactWindow)'
      say "  applied         auto-compaction disabled; /compact remains available"
      ;;
    *)
      err "compaction '$1' is preview-only until a token window is specified"
      return "$EX_USAGE"
      ;;
  esac
}

do_setup_preview() {
  local mode="$1" dry_run=0 yes=0 non_interactive=0 provider_requested=0 preset="recommended" profile="balanced"
  local provider="$( [ -f "$FKT_HOME/providers/.active" ] && tr -d '[:space:]' < "$FKT_HOME/providers/.active" || printf 'anthropic' )"
  local model="" effort="" permission_mode="" compaction="" updates="" auth="" skill_packs="" mcps=""
  while [ $# -gt 1 ]; do
    shift
    case "$1" in
      --dry-run|--preview) dry_run=1 ;;
      --yes) yes=1 ;;
      --non-interactive) non_interactive=1 ;;
      --preset) shift; preset="$(normalize_preset "${1:-}")" || { err "invalid preset: ${1:-}"; return "$EX_USAGE"; } ;;
      --profile) shift; profile="$(normalize_profile "${1:-}")" || { err "invalid profile: ${1:-}"; return "$EX_USAGE"; } ;;
      --provider) shift; provider="${1:-}"; provider_requested=1; [ -n "$provider" ] || { err "--provider requires a value"; return "$EX_USAGE"; } ;;
      --model) shift; model="${1:-}"; [ -n "$model" ] || { err "--model requires a value"; return "$EX_USAGE"; } ;;
      --effort) shift; effort="${1:-}"; case "$effort" in low|medium|high|xhigh|none) ;; *) err "invalid effort: $effort"; return "$EX_USAGE" ;; esac ;;
      --permission-mode) shift; permission_mode="${1:-}"; case "$permission_mode" in manual|plan|acceptEdits|dontAsk|auto) ;; *) err "invalid permission mode: $permission_mode"; return "$EX_USAGE" ;; esac ;;
      --compaction) shift; compaction="${1:-}"; case "$compaction" in auto|off|tokens) ;; *) err "invalid compaction: $compaction"; return "$EX_USAGE" ;; esac ;;
      --updates) shift; updates="${1:-}"; case "$updates" in enabled|disabled) ;; *) err "invalid updates setting: $updates"; return "$EX_USAGE" ;; esac ;;
      --auth) shift; auth="${1:-}"; case "$auth" in login|skip) ;; *) err "invalid auth setting: $auth"; return "$EX_USAGE" ;; esac ;;
      --skill-pack)
        shift
        [ -n "${1:-}" ] || { err "--skill-pack requires a value"; return "$EX_USAGE"; }
        normalize_config_id "${1:-}" >/dev/null || { err "invalid skill pack: ${1:-}"; return "$EX_USAGE"; }
        skill_packs="${skill_packs}${skill_packs:+,}${1:-}"
        ;;
      --mcp) shift; mcps="${mcps}${mcps:+,}${1:-}"; [ -n "${1:-}" ] || { err "--mcp requires a value"; return "$EX_USAGE"; } ;;
      -h|--help) setup_usage; return 0 ;;
      *) err "unknown $mode option: $1"; setup_usage >&2; return "$EX_USAGE" ;;
    esac
  done

  if [ "$dry_run" = "1" ] && [ "$yes" = "1" ]; then
    err "$mode accepts either --dry-run or --yes, not both"
    return "$EX_USAGE"
  fi

  if [ "$dry_run" != "1" ] && [ "$yes" != "1" ]; then
    err "$mode write mode requires --yes, or use --dry-run to preview"
    return "$EX_USAGE"
  fi

  if [ "$non_interactive" = "1" ] && [ "$auth" = "login" ]; then
    err "$mode --auth login may prompt; omit --non-interactive or use --auth skip"
    return "$EX_USAGE"
  fi

  if [ "$dry_run" != "1" ] \
     && [ -z "$updates" ] \
     && [ "$provider_requested" != "1" ] \
     && [ -z "$model" ] \
     && [ -z "$permission_mode" ] \
     && [ -z "$auth" ] \
     && [ -z "$skill_packs" ] \
     && { [ -z "$compaction" ] || [ "$compaction" = "tokens" ]; }; then
    err "$mode write mode currently requires --updates, --provider, --model, --auth, --permission-mode, --skill-pack, or --compaction auto|off"
    return "$EX_USAGE"
  fi

  say "fkt $mode $([ "$dry_run" = "1" ] && echo preview || echo apply)"
  say "  preset          $preset"
  say "  profile         $profile"
  say "  provider        $provider"
  say "  model           ${model:-keep-current}"
  say "  effort          ${effort:-keep-current}"
  say "  permission mode ${permission_mode:-keep-current}"
  say "  compaction      ${compaction:-keep-current}"
  say "  updates         ${updates:-keep-current}"
  say "  auth            ${auth:-keep-current}"
  say "  skill packs     ${skill_packs:-keep-current}"
  say "  mcp             ${mcps:-keep-current}"
  say "  non-interactive $([ "$non_interactive" = "1" ] && echo yes || echo no)"
  say ""
  if [ "$dry_run" = "1" ]; then
    say "No files changed. Manual commands this preview may imply:"
    say "  ccs $provider"
    [ -n "$model" ] && say "  ccs model $model ${effort:-medium}"
    [ "$updates" = "disabled" ] && say "  fkt disable"
    [ "$updates" = "enabled" ] && say "  fkt enable"
    [ "$auth" = "login" ] && say "  ccs login $provider"
    return 0
  fi

  if [ -n "$updates" ]; then
    backup_config_file
    case "$updates" in
      enabled) config_set update_check true; say "  applied         update checks enabled" ;;
      disabled) config_set update_check false; say "  applied         update checks disabled" ;;
    esac
  fi
  if [ "$provider_requested" = "1" ]; then
    backup_runtime_config_files "$provider"
    ccs_command "$provider" >/dev/null
    say "  applied         provider $provider"
  fi
  if [ -n "$auth" ]; then
    case "$auth" in
      login)
        ccs_command login "$provider"
        say "  applied         auth login delegated for $provider"
        ;;
      skip)
        say "  applied         auth skipped"
        ;;
    esac
  fi
  if [ -n "$model" ]; then
    backup_runtime_config_files codex
    ccs_command model "$model" "${effort:-medium}" >/dev/null
    say "  applied         model $model (${effort:-medium})"
  fi
  if [ -n "$permission_mode" ]; then
    backup_file_once "$FKT_HOME/settings.json" settings.json
    apply_permission_mode_setting "$permission_mode"
  fi
  if [ -n "$compaction" ]; then
    case "$compaction" in
      auto|off)
        backup_file_once "$FKT_HOME/settings.json" settings.json
        apply_compaction_setting "$compaction"
        ;;
      tokens)
        say "  not applied     compaction tokens requires an explicit token window"
        ;;
    esac
  fi
  if [ -n "$skill_packs" ]; then
    backup_config_file
    local old_ifs="$IFS" pack key
    IFS=','
    for pack in $skill_packs; do
      key="skill_pack_$(normalize_config_id "$pack")_enabled"
      config_set "$key" true
      say "  applied         skill pack preference $pack"
    done
    IFS="$old_ifs"
  fi
  if [ -n "$mcps" ]; then
    say "  not applied     mcp setup choices use: fkt mcp enable <id>"
  fi
}

# ---------------------------------------------------------------------------
# status / channel / snooze
# ---------------------------------------------------------------------------
do_status() {
  local current ch
  current="$(installed_version)"
  ch="$(channel)"
  say "fk-toolkit $current"
  say "  checkout       $FKT_HOME$(is_git_checkout || printf ' (not a git checkout)')"
  say "  channel        $ch"
  say "  remote         $(remote_url)"
  say "  config         $CONFIG_FILE"
  say "  state          $FKT_STATE_DIR"
  say "  update checks  $(checks_enabled && echo enabled || echo disabled)"
  say "  advisories     $(advisories_enabled && echo enabled || echo disabled)"
  if [ -f "$CHECK_CACHE" ]; then
    # Read the record once and report from that snapshot. `check` discards a
    # record it finds invalid, and the hook fires one in the background on every
    # session, so the file can vanish partway through this line: field-by-field
    # reads render half of it from before the delete and half from after, which
    # printed a real "last check      (latest: ) — stale, written for 0.3.0".
    #
    # Say so when the record predates the installed version. `status` reports,
    # it does not repair: leave the file for `check` to discard on its own terms.
    local last_status="" last_for="" last_latest="" staleness=""
    read -r last_status last_for last_latest _ < "$CHECK_CACHE" 2>/dev/null || true
    cache_valid_for "$current" "$ch" || staleness=" — stale, written for ${last_for:-an unknown version}; re-run 'fkt check --force'"
    say "  last check     ${last_status:-unreadable} (latest: ${last_latest:--})$staleness"
  else
    say "  last check     never"
  fi
  if [ -f "$SNOOZE_FILE" ]; then
    say "  snoozed        $(awk 'NR==1{print $1}' "$SNOOZE_FILE") until $(awk 'NR==1{print $2}' "$SNOOZE_FILE")"
  fi
  if is_git_checkout; then
    local dirty
    dirty="$(git_at status --porcelain --untracked-files=no 2>/dev/null | wc -l | tr -d ' ')"
    say "  worktree       $([ "$dirty" = "0" ] && echo clean || echo "$dirty modified tracked file(s)")"
  fi
  say ""
  say "Plugins (skills/fk-*) are managed by Claude Code, not by fkt:"
  say "  /plugin marketplace update fk-toolkit"
  print_advisories "$current"
  return 0
}

do_channel() {
  if [ $# -eq 0 ]; then
    channel
    return 0
  fi
  case "$1" in
    stable|edge)
      config_set channel "$1"
      rm -f "$CHECK_CACHE" "$SNOOZE_FILE"
      say "channel set to $1 (update cache cleared)"
      ;;
    *) err "channel must be 'stable' or 'edge'"; return "$EX_USAGE" ;;
  esac
}

do_snooze() {
  local hours="${1:-${FKT_SNOOZE_HOURS:-168}}"
  case "$hours" in (''|*[!0-9]*) err "snooze takes a whole number of hours"; return "$EX_USAGE" ;; esac
  local latest
  latest="$(cache_field 3 2>/dev/null || true)"
  if [ -z "$latest" ] || [ "$latest" = "-" ]; then
    err "nothing to snooze; run 'fkt check' first"
    return "$EX_USAGE"
  fi
  mkdir -p "$FKT_STATE_DIR"
  printf '%s %s\n' "$latest" "$(( $(date +%s) + hours * 3600 ))" > "$SNOOZE_FILE"
  say "snoozed $latest for ${hours}h (a newer release breaks through)"
}

do_disable() {
  config_set update_check false
  say "update checks disabled. Security advisories still apply; disable them with:"
  say "  fkt config security_notices false"
}

do_enable() {
  config_set update_check true
  rm -f "$CHECK_CACHE"
  say "update checks enabled"
}

do_config() {
  if [ $# -eq 0 ]; then
    if [ -f "$CONFIG_FILE" ]; then
      cat "$CONFIG_FILE"
    else
      say "# no config yet ($CONFIG_FILE)"
    fi
    return 0
  fi
  [ $# -eq 2 ] || { err "usage: fkt config <key> <value>"; return "$EX_USAGE"; }
  case "$1" in
    channel|update_check|security_notices|check_ttl_minutes) config_set "$1" "$2" ;;
    *) err "unknown config key \"$1\" (channel, update_check, security_notices, check_ttl_minutes)"; return "$EX_USAGE" ;;
  esac
  say "$1 = $2"
}


mcp_registry_rows() {
  [ -r "$MCP_REGISTRY" ] || return 0
  awk '
    function val(line) {
      sub(/^[^=]*=[[:space:]]*/, "", line)
      sub(/[[:space:]]*#.*/, "", line)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", line)
      if (line ~ /^".*"$/) { sub(/^"/, "", line); sub(/"$/, "", line) }
      return line
    }
    function flush() {
      if (id != "") printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n", id, plugin, auth, def, transport, url, display, source
    }
    /^\[\[servers\]\]/ { flush(); id=plugin=auth=def=transport=url=display=source=""; next }
    /^[[:space:]]*id[[:space:]]*=/ { id=val($0); next }
    /^[[:space:]]*plugin[[:space:]]*=/ { plugin=val($0); next }
    /^[[:space:]]*display_name[[:space:]]*=/ { display=val($0); next }
    /^[[:space:]]*url[[:space:]]*=/ { url=val($0); next }
    /^[[:space:]]*transport[[:space:]]*=/ { transport=val($0); next }
    /^[[:space:]]*auth[[:space:]]*=/ { auth=val($0); next }
    /^[[:space:]]*default_enabled[[:space:]]*=/ { def=val($0); next }
    /^[[:space:]]*source_url[[:space:]]*=/ { source=val($0); next }
    END { flush() }
  ' "$MCP_REGISTRY"
}

mcp_effective_enabled() {
  local id="$1" def="$2" override
  override="$(config_get "mcp_${id}_enabled" "")"
  case "$override" in
    true|false) printf '%s\n' "$override" ;;
    *) printf '%s\n' "$def" ;;
  esac
}

mcp_state_for() {
  local id="$1" auth="$2" def="$3" enabled
  enabled="$(mcp_effective_enabled "$id" "$def")"
  if [ "$enabled" != "true" ]; then
    printf 'disabled'
  elif [ "$auth" = "none" ]; then
    printf 'enabled'
  else
    printf 'login-required'
  fi
}

mcp_scope_for() {
  local auth="$1" def="$2"
  if [ "$auth" = "none" ] && [ "$def" = "true" ]; then
    printf 'portable'
  elif [ "$auth" = "none" ]; then
    printf 'optional'
  else
    printf 'native-login'
  fi
}

mcp_duplicate_for() {
  local url="$1" rows="$2" count
  count="$(printf '%s\n' "$rows" | awk -F '	' -v url="$url" '$6 == url { n++ } END { print n+0 }')"
  [ "$count" -gt 1 ] && printf 'duplicate' || printf 'ok'
}

mcp_known_id() {
  local want="$1"
  mcp_registry_rows | awk -F '	' -v want="$want" '$1 == want { found=1 } END { exit(found ? 0 : 1) }'
}

mcp_extract_urls() {
  awk '{
    line = $0
    while (match(line, /https?:\/\/[^[:space:])]+/)) {
      url = substr(line, RSTART, RLENGTH)
      print url
      line = substr(line, RSTART + RLENGTH)
    }
  }' | sort -u
}

mcp_host_urls() {
  local host="$1" bin
  [ "${FKT_MCP_LIVE_CHECK:-1}" != "0" ] || return 0
  case "$host" in
    claude) bin="$CLAUDE_BIN" ;;
    codex) bin="$CODEX_BIN" ;;
    *) return 0 ;;
  esac
  command -v "$bin" >/dev/null 2>&1 || return 0
  "$bin" mcp list 2>/dev/null | mcp_extract_urls || true
}

mcp_count_lines() {
  awk 'NF { n++ } END { print n+0 }'
}

mcp_intersection_count() {
  awk 'FNR == NR { seen[$0]=1; next } NF && seen[$0] { n++ } END { print n+0 }' "$1" "$2"
}

mcp_enabled_urls() {
  local rows="$1"
  while IFS=$'\t' read -r id _plugin _auth def _transport url _display _source; do
    [ -n "$id" ] || continue
    [ "$(mcp_effective_enabled "$id" "$def")" = "true" ] || continue
    printf '%s\n' "$url"
  done <<EOF_MCP_ENABLED_URLS
$rows
EOF_MCP_ENABLED_URLS
}


mcp_validate_manifest() {
  local rows="$1" tmp_dir expected actual auth_urls leaks expected_count actual_count
  if [ ! -f "$MCP_MANIFEST" ]; then
    say "manifest status  missing"
    return 0
  fi
  command -v jq >/dev/null 2>&1 || { say "manifest status  unchecked (jq missing)"; return 0; }
  tmp_dir="$(mktemp -d "${TMPDIR:-/tmp}/fkt-mcp-manifest.XXXXXX")"
  expected="$tmp_dir/expected.tsv"
  actual="$tmp_dir/actual.tsv"
  auth_urls="$tmp_dir/auth.urls"
  printf '%s\n' "$rows" | awk -F '\t' '
    $2 == "fk-toolkit-ops" && $3 == "none" && $4 == "true" {
      type = ($5 == "http" ? "streamable-http" : $5)
      print $1 "\t" type "\t" $6
    }
  ' | sort > "$expected"
  if ! jq -r '(.mcpServers // {}) | to_entries[] | [.key, (.value.type // ""), (.value.url // "")] | @tsv' "$MCP_MANIFEST" 2>/dev/null | sort > "$actual"; then
    rm -rf "$tmp_dir"
    err "plugin MCP manifest is not valid JSON: $MCP_MANIFEST"
    return "$EX_USAGE"
  fi
  if ! cmp -s "$expected" "$actual"; then
    err "plugin MCP manifest drifted from mcp-registry.toml: $MCP_MANIFEST"
    err "regenerate catalog output with: bun run catalog:generate"
    rm -rf "$tmp_dir"
    return "$EX_USAGE"
  fi
  printf '%s\n' "$rows" | awk -F '\t' '$2 == "fk-toolkit-ops" && $3 != "none" { print $6 }' | sort -u > "$auth_urls"
  leaks="$(awk 'FNR == NR { auth[$0]=1; next } NF && auth[$3] { n++ } END { print n+0 }' "$auth_urls" "$actual")"
  if [ "$leaks" != "0" ]; then
    err "plugin MCP manifest includes auth-required endpoint(s); keep those native-login only"
    rm -rf "$tmp_dir"
    return "$EX_USAGE"
  fi
  expected_count="$(mcp_count_lines < "$expected")"
  actual_count="$(mcp_count_lines < "$actual")"
  rm -rf "$tmp_dir"
  say "manifest servers $actual_count valid (expected $expected_count)"
  return 0
}


# ---------------------------------------------------------------------------
# uninstall
# ---------------------------------------------------------------------------
uninstall_usage() {
  cat <<'EOF'
usage: fkt uninstall --dry-run
       fkt uninstall --yes

Safe uninstall removes toolkit-owned command shims and moves the bootstrap
checkout plus fkt config/state into a timestamped backup directory. It does not
delete Claude Code auth/session state, MCP OAuth state, Codex auth, or gstack
state.
EOF
}

path_is_within() {
  case "$1" in
    "$2"|"$2"/*) return 0 ;;
    *) return 1 ;;
  esac
}

shim_owned_by_toolkit() {
  local file="$1" name="$2"
  [ -f "$file" ] || return 1
  case "$name" in
    ccs)
      grep -q 'exec "$toolkit_dir/bin/cc-provider" "$@"' "$file" 2>/dev/null || return 1
      ;;
    fkt)
      grep -q 'exec "$toolkit_dir/bin/fkt" "$@"' "$file" 2>/dev/null || return 1
      ;;
    ccs.ps1)
      grep -q "bin\\cc-provider" "$file" 2>/dev/null || grep -q "bin/cc-provider" "$file" 2>/dev/null || return 1
      ;;
    fkt.ps1)
      grep -q "bin\\fkt" "$file" 2>/dev/null || grep -q "bin/fkt" "$file" 2>/dev/null || return 1
      ;;
    *) return 1 ;;
  esac
  return 0
}

move_if_exists() {
  local src="$1" dest_dir="$2" label="$3" base dest
  [ -e "$src" ] || return 0
  mkdir -p "$dest_dir"
  base="$(basename "$src")"
  dest="$dest_dir/$label-$base"
  if [ -e "$dest" ]; then
    dest="$dest.$$"
  fi
  mv "$src" "$dest"
  say "  moved           $src -> $dest"
}

remove_shim_if_owned() {
  local file="$1" name="$2"
  [ -e "$file" ] || return 0
  if shim_owned_by_toolkit "$file" "$name"; then
    rm -f "$file"
    say "  removed         $file"
  else
    say "  preserved       $file (not a toolkit-owned shim)"
  fi
}

do_uninstall() {
  local dry_run=1 yes=0 stamp backup_root user_bin
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run|--preview) dry_run=1 ;;
      --yes) yes=1; dry_run=0 ;;
      -h|--help) uninstall_usage; return 0 ;;
      *) err "unknown uninstall option: $1"; uninstall_usage >&2; return "$EX_USAGE" ;;
    esac
    shift
  done
  if [ "$yes" != "1" ] && [ "$dry_run" != "1" ]; then
    err "uninstall requires --dry-run or --yes"
    return "$EX_USAGE"
  fi

  stamp="$(date +%Y%m%d%H%M%S)"
  backup_root="${XDG_STATE_HOME:-$HOME/.local/state}/fk-toolkit-uninstall/$stamp"
  user_bin="$HOME/.local/bin"

  say "fkt uninstall $([ "$dry_run" = "1" ] && echo preview || echo apply)"
  say "  toolkit        $FKT_HOME"
  say "  backup         $backup_root"
  say "  remove shims   $user_bin/ccs, $user_bin/fkt, $user_bin/ccs.ps1, $user_bin/fkt.ps1 when toolkit-owned"
  say "  move checkout  $FKT_HOME"
  say "  move config    $FKT_CONFIG_DIR"
  say "  move state     $FKT_STATE_DIR"
  say "  preserve       $HOME/.claude.json (Claude auth, MCP OAuth, sessions)"
  say "  preserve       $HOME/.gstack (gstack state/cache)"
  say ""

  if [ "$dry_run" = "1" ]; then
    say "No files changed. Re-run with: fkt uninstall --yes"
    return 0
  fi

  if [ -n "$FKT_HOME" ] && { [ "$FKT_HOME" = "/" ] || [ "$FKT_HOME" = "$HOME" ]; }; then
    err "refusing to uninstall unsafe toolkit path: $FKT_HOME"
    return "$EX_REFUSED"
  fi
  if [ -n "$FKT_CONFIG_DIR" ] && { [ "$FKT_CONFIG_DIR" = "/" ] || [ "$FKT_CONFIG_DIR" = "$HOME" ]; }; then
    err "refusing to uninstall unsafe config path: $FKT_CONFIG_DIR"
    return "$EX_REFUSED"
  fi
  if [ -n "$FKT_STATE_DIR" ] && { [ "$FKT_STATE_DIR" = "/" ] || [ "$FKT_STATE_DIR" = "$HOME" ]; }; then
    err "refusing to uninstall unsafe state path: $FKT_STATE_DIR"
    return "$EX_REFUSED"
  fi
  if path_is_within "$backup_root" "$FKT_HOME"; then
    err "backup path must not be inside toolkit checkout"
    return "$EX_REFUSED"
  fi
  if path_is_within "$backup_root" "$FKT_STATE_DIR"; then
    err "backup path must not be inside fkt state directory"
    return "$EX_REFUSED"
  fi

  mkdir -p "$backup_root"
  remove_shim_if_owned "$user_bin/ccs" ccs
  remove_shim_if_owned "$user_bin/fkt" fkt
  remove_shim_if_owned "$user_bin/ccs.ps1" ccs.ps1
  remove_shim_if_owned "$user_bin/fkt.ps1" fkt.ps1
  move_if_exists "$FKT_CONFIG_DIR" "$backup_root" config
  move_if_exists "$FKT_STATE_DIR" "$backup_root" state
  move_if_exists "$FKT_HOME" "$backup_root" checkout
  say "  preserved       $HOME/.claude.json"
  say "  preserved       $HOME/.gstack"
  say "Uninstall complete. Backup: $backup_root"
}

do_mcp() {
  local sub="${1:-status}"
  [ $# -gt 0 ] && shift
  case "$sub" in
    list|status)
      if [ ! -r "$MCP_REGISTRY" ]; then
        err "MCP registry not found: $MCP_REGISTRY"
        return "$EX_USAGE"
      fi
      local rows
      rows="$(mcp_registry_rows)"
      say "MCP starter registry ($MCP_REGISTRY)"
      printf '%-22s %-15s %-12s %-8s %-15s %-9s %s
' "id" "owner" "scope" "auth" "state" "duplicate" "url"
      printf '%s
' "$rows" | while IFS=$'	' read -r id plugin auth def _transport url _display _source; do
        [ -n "$id" ] || continue
        printf '%-22s %-15s %-12s %-8s %-15s %-9s %s
' "$id" "$plugin" "$(mcp_scope_for "$auth" "$def")" "$auth" "$(mcp_state_for "$id" "$auth" "$def")" "$(mcp_duplicate_for "$url" "$rows")" "$url"
      done
      ;;
    auth)
      local want="${1:-}" found=0
      [ -n "$want" ] || { err "usage: fkt mcp auth <id>"; return "$EX_USAGE"; }
      while IFS=$'\t' read -r id _plugin auth def transport url display source; do
        [ "$id" = "$want" ] || continue
        found=1
        say "$display ($id)"
        say "  url       $url"
        say "  transport $transport"
        say "  auth      $auth"
        say "  state     $(mcp_state_for "$id" "$auth" "$def")"
        [ -n "$source" ] && say "  docs      $source"
        case "$auth" in
          none)
            say "  login     no login required"
            ;;
          oauth)
            say "  Claude    claude mcp add --transport http $id $url; then run /mcp"
            say "  Codex     codex mcp add $id --url $url; then run: codex mcp login $id"
            ;;
          api-key)
            say "  Claude    add with claude mcp, then store the token through Claude's MCP auth flow"
            say "  Codex     add with codex mcp, then use Codex's native MCP auth/token flow"
            ;;
        esac
      done <<EOF_MCP_ROWS
$(mcp_registry_rows)
EOF_MCP_ROWS
      [ "$found" = "1" ] || { err "unknown MCP server: $want"; return "$EX_USAGE"; }
      ;;
    enable|disable)
      local want="${1:-}" value="true"
      [ -n "$want" ] || { err "usage: fkt mcp $sub <id>"; return "$EX_USAGE"; }
      [ "$sub" = "disable" ] && value="false"
      mcp_known_id "$want" || { err "unknown MCP server: $want"; return "$EX_USAGE"; }
      config_set "mcp_${want}_enabled" "$value"
      say "mcp $want enabled = $value"
      if [ "$value" = "true" ]; then
        "$0" mcp auth "$want"
      fi
      ;;
    doctor)
      local rows enabled=0 requested_login=0 bad_auth_enabled missing_manifest=0 duplicates=0
      local claude_urls codex_urls enabled_urls tmp_dir claude_file codex_file enabled_file
      local claude_count codex_count cross_host_duplicates enabled_host_duplicates
      rows="$(mcp_registry_rows)"
      if [ -z "$rows" ]; then
        err "MCP registry is empty or unreadable: $MCP_REGISTRY"
        return "$EX_USAGE"
      fi
      while IFS=$'	' read -r id _plugin auth def _transport _url _display _source; do
        [ -n "$id" ] || continue
        [ "$(mcp_effective_enabled "$id" "$def")" = "true" ] || continue
        if [ "$auth" = "none" ]; then
          enabled=$((enabled + 1))
        else
          requested_login=$((requested_login + 1))
        fi
      done <<EOF_MCP_DOCTOR_ROWS
$rows
EOF_MCP_DOCTOR_ROWS
      bad_auth_enabled="$(printf '%s
' "$rows" | awk -F '	' '$3 != "none" && $4 == "true" { n++ } END { print n+0 }')"
      duplicates="$(printf '%s
' "$rows" | awk -F '	' '{ urls[$6]++ } END { for (u in urls) if (urls[u] > 1) n++ ; print n+0 }')"
      [ "$bad_auth_enabled" = "0" ] || { err "auth-required MCP entries must not be default_enabled=true"; return "$EX_USAGE"; }
      [ -f "$MCP_MANIFEST" ] || missing_manifest=1
      claude_urls="$(mcp_host_urls claude)"
      codex_urls="$(mcp_host_urls codex)"
      enabled_urls="$(mcp_enabled_urls "$rows")"
      claude_count="$(printf '%s
' "$claude_urls" | mcp_count_lines)"
      codex_count="$(printf '%s
' "$codex_urls" | mcp_count_lines)"
      tmp_dir="$(mktemp -d "${TMPDIR:-/tmp}/fkt-mcp.XXXXXX")"
      claude_file="$tmp_dir/claude.urls"
      codex_file="$tmp_dir/codex.urls"
      enabled_file="$tmp_dir/enabled.urls"
      printf '%s
' "$claude_urls" > "$claude_file"
      printf '%s
' "$codex_urls" > "$codex_file"
      printf '%s
' "$enabled_urls" > "$enabled_file"
      cross_host_duplicates="$(mcp_intersection_count "$claude_file" "$codex_file")"
      enabled_host_duplicates="$(( $(mcp_intersection_count "$enabled_file" "$claude_file") + $(mcp_intersection_count "$enabled_file" "$codex_file") ))"
      rm -rf "$tmp_dir"
      say "registry entries  $(printf '%s
' "$rows" | grep -c .)"
      say "enabled no-auth   $enabled server(s)"
      say "login requested   $requested_login server(s)"
      say "duplicate urls    $duplicates"
      say "claude mcp urls   $claude_count"
      say "codex mcp urls    $codex_count"
      say "cross-host dupes  $cross_host_duplicates"
      say "enabled dupes     $enabled_host_duplicates"
      if [ "$missing_manifest" = "1" ]; then
        warn "generated plugin MCP manifest missing: $MCP_MANIFEST"
      else
        say "plugin manifest   $MCP_MANIFEST"
        mcp_validate_manifest "$rows"
      fi
      ;;
    *)
      err "usage: fkt mcp [list|status|auth <id>|enable <id>|disable <id>|doctor]"
      return "$EX_USAGE"
      ;;
  esac
}

usage() {
  cat <<'EOF'
fkt — FK Claude Toolkit updater (bootstrap layer only)

  fkt status                 what is installed, which channel, cached check state
  fkt advisories             applicable security advisories, one TSV row each
                             (id, severity, summary, url) — for scripts
  fkt version                print the installed version
  fkt check [--force] [--quiet]
                             is an update available? (cached; exit 10 if yes)
  fkt update [-y] [--dry-run]
                             fast-forward the checkout, then run migrations
  fkt disk                   what ~/.claude costs, and which of it core sweeps
                             on its own (read-only; deletes nothing)
  fkt uninstall --dry-run    preview safe uninstall; --yes moves files to backup
  fkt doctor                 read-only setup/config/provider health summary
  fkt presets                list setup presets and runtime profiles
  fkt setup --dry-run        preview setup choices without writing files
  fkt configure --dry-run    preview reconfiguration choices without writing files
  fkt migrate                run pending migrations only
  fkt channel [stable|edge]  show or set the update channel
  fkt snooze [HOURS]         hide the current update for a while (default 168)
  fkt enable | disable       turn update checks on or off
  fkt config [KEY VALUE]     show or set configuration
  fkt mcp [list|auth|enable|disable|doctor]
                             curated MCP starter registry and auth state

Channels:
  stable  latest v* release tag  (default)
  edge    origin/main

Exit codes: 0 ok · 2 usage · 10 update available · 20 refused (local work)
            30 offline · 40 not a git checkout · 50 migration failed

Plugins under skills/fk-* are updated by Claude Code, not by fkt.
EOF
}

main() {
  local cmd="${1:-status}"
  [ $# -gt 0 ] && shift
  case "$cmd" in
    status)          do_status "$@" ;;
    advisories)      do_advisories "$@" ;;
    version)         installed_version ;;
    schema-version)  printf '%s\n' "$FKT_VERSION_SCHEMA" ;;
    check)           do_check "$@" ;;
    disk)            do_disk "$@" ;;
    uninstall)       do_uninstall "$@" ;;
    doctor)          do_doctor "$@" ;;
    presets)         do_presets "$@" ;;
    setup)           do_setup_preview setup "$@" ;;
    configure)       do_setup_preview configure "$@" ;;
    update|upgrade)  do_update "$@" ;;
    migrate)         do_migrate "$@" ;;
    channel)         do_channel "$@" ;;
    snooze)          do_snooze "$@" ;;
    enable)          do_enable "$@" ;;
    disable)         do_disable "$@" ;;
    config)          do_config "$@" ;;
    mcp)             do_mcp "$@" ;;
    -h|--help|help)  usage ;;
    *)               err "unknown command: $cmd"; usage >&2; return "$EX_USAGE" ;;
  esac
}

main "$@"